@{
    ViewData["Title"] = "Không có quyền truy cập";
    Layout = "_Layout";
}

<section class="inner_page position_head">
    <div class="container">
        <div class="row justify-content-center text-center" style="padding: 80px 0;">
            <div class="col-md-6">
                <div style="font-size: 80px; color: #e74c3c; margin-bottom: 20px;">
                    <i class="fa fa-ban"></i>
                </div>
                <h2 class="fw-bold" style="color:#2d3748;">403 — Không có quyền</h2>
                <p class="text-muted mb-4">
                    Bạn không có quyền truy cập trang này.<br />
                    Vui lòng đăng nhập bằng tài khoản có quyền phù hợp.
                </p>
                <div class="d-flex gap-3 justify-content-center">
                    <a asp-area="Customers" asp-controller="Home" asp-action="Index"
                       class="btn btn-outline-secondary px-4">
                        <i class="fa fa-home me-1"></i> Về trang chủ
                    </a>
                    <a asp-controller="Auth" asp-action="Login"
                       class="btn btn-theme-primary px-4">
                        <i class="fa fa-sign-in me-1"></i> Đăng nhập lại
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>