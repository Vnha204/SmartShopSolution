@model LoginVM
@{
    ViewData["Title"] = "Đăng nhập";
    Layout = "_Layout";
}

<section class="inner_page position_head">
    <div class="container">
        <div class="row justify-content-center auth-page-row">
            <div class="col-md-5 col-sm-10">

                <div class="card shadow-sm border-0 rounded-3">
                    <div class="card-body p-4 p-md-5">

                        <div class="text-center mb-4">
                            <h3 class="fw-bold text-theme-link">
                                <i class="fa fa-user-circle me-2"></i> Đăng nhập
                            </h3>
                            <p class="text-muted small">Chào mừng bạn trở lại SmartShop</p>
                        </div>

                        @if (TempData["Success"] != null)
                        {
                            <div class="alert alert-success py-2 small">@TempData["Success"]</div>
                        }

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger py-2 small">
                                <ul class="mb-0 ps-3">
                                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                    {
                                        <li>@error.ErrorMessage</li>
                                    }
                                </ul>
                            </div>
                        }

                        <form asp-controller="Auth" asp-action="Login" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                            <div class="mb-3">
                                <label asp-for="Email" class="form-label fw-semibold small"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">
                                        <i class="fa fa-envelope text-muted"></i>
                                    </span>
                                    <input asp-for="Email" type="email"
                                           class="form-control border-start-0 ps-0"
                                           placeholder="example@email.com"
                                           autocomplete="email" />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <label asp-for="Password" class="form-label fw-semibold small mb-0"></label>
                                    <a asp-controller="Auth" asp-action="ForgotPassword"
                                       class="small text-muted text-decoration-none">Quên mật khẩu?</a>
                                </div>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">
                                        <i class="fa fa-lock text-muted"></i>
                                    </span>
                                    <input asp-for="Password" type="password"
                                           class="form-control border-start-0 ps-0"
                                           placeholder="••••••"
                                           autocomplete="current-password"
                                           id="loginPasswordInput" />
                                    <button type="button" class="input-group-text bg-light border-start-0"
                                            data-pw-toggle="loginPasswordInput">
                                        <i class="fa fa-eye text-muted"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <div class="mb-4 form-check">
                                <input asp-for="RememberMe" type="checkbox" class="form-check-input" id="rememberMe" />
                                <label class="form-check-label small" for="rememberMe">Ghi nhớ đăng nhập</label>
                            </div>

                            <button type="submit" class="btn btn-theme-primary w-100 fw-semibold py-2">
                                <i class="fa fa-sign-in me-2"></i> Đăng nhập
                            </button>
                        </form>

                        <div class="text-center mt-4 pt-2 border-top">
                            <p class="small text-muted mb-0">
                                Chưa có tài khoản?
                                <a asp-controller="Auth" asp-action="Register"
                                   class="fw-semibold text-decoration-none text-theme-link">
                                    Đăng ký ngay
                                </a>
                            </p>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </div>
</section>
