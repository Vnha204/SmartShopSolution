@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
    Layout = "_Layout";
}

<section class="inner_page position_head">
    <div class="container">
        <div class="row justify-content-center auth-page-row">
            <div class="col-md-5 col-sm-10">
                <div class="card auth-card">
                    <div class="card-body">

                        <div class="text-center mb-4">
                            <div class="auth-step-icon">
                                <i class="fa fa-envelope"></i>
                            </div>
                            <h4 class="fw-bold">Quên mật khẩu?</h4>
                            <p class="text-muted small">Nhập email của bạn, chúng tôi sẽ gửi mã OTP để đặt lại mật khẩu.</p>
                        </div>

                        @if (TempData["Error"] != null)
                        {
                            <div class="alert alert-danger py-2 small">@TempData["Error"]</div>
                        }

                        <form asp-controller="Auth" asp-action="ForgotPassword" method="post" class="forgot-password-form">
                            @Html.AntiForgeryToken()

                            <div class="mb-3">
                                <label asp-for="Email" class="form-label fw-semibold small"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">
                                        <i class="fa fa-envelope text-muted"></i>
                                    </span>
                                    <input asp-for="Email" type="email"
                                           class="form-control border-start-0 ps-0"
                                           placeholder="example@email.com"
                                           autocomplete="email" />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <button type="submit" class="btn btn-theme-primary w-100 fw-semibold py-2">
                                <i class="fa fa-paper-plane me-2"></i> Gửi mã OTP
                            </button>
                        </form>

                        <div class="text-center mt-3">
                            <a asp-controller="Auth" asp-action="Login"
                               class="small text-muted text-decoration-none">
                                <i class="fa fa-arrow-left me-1"></i> Quay lại đăng nhập
                            </a>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
