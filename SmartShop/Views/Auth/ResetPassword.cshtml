@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
    Layout = "_Layout";
}

<section class="inner_page position_head">
    <div class="container">
        <div class="row justify-content-center auth-page-row">
            <div class="col-md-5 col-sm-10">
                <div class="card auth-card">
                    <div class="card-body">

                        <div class="text-center mb-4">
                            <div class="auth-step-icon">
                                <i class="fa fa-lock"></i>
                            </div>
                            <h4 class="fw-bold">Đặt mật khẩu mới</h4>
                            <p class="text-muted small">Mật khẩu tối thiểu 6 ký tự.</p>
                        </div>

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger py-2 small">
                                <ul class="mb-0 ps-3">
                                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                    {
                                        <li>@error.ErrorMessage</li>
                                    }
                                </ul>
                            </div>
                        }

                        <form asp-controller="Auth" asp-action="ResetPassword" method="post" class="forgot-password-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="Email" />
                            <input type="hidden" asp-for="OtpCode" />

                            <div class="mb-3">
                                <label asp-for="NewPassword" class="form-label fw-semibold small"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">
                                        <i class="fa fa-lock text-muted"></i>
                                    </span>
                                    <input asp-for="NewPassword" type="password"
                                           class="form-control border-start-0 ps-0"
                                           placeholder="••••••"
                                           id="newPasswordInput" />
                                    <button type="button" class="input-group-text bg-light border-start-0"
                                            data-pw-toggle="newPasswordInput">
                                        <i class="fa fa-eye text-muted"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="NewPassword" class="text-danger small"></span>
                            </div>

                            <div class="mb-4">
                                <label asp-for="ConfirmPassword" class="form-label fw-semibold small"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">
                                        <i class="fa fa-lock text-muted"></i>
                                    </span>
                                    <input asp-for="ConfirmPassword" type="password"
                                           class="form-control border-start-0 ps-0"
                                           placeholder="••••••"
                                           id="confirmPasswordInput" />
                                    <button type="button" class="input-group-text bg-light border-start-0"
                                            data-pw-toggle="confirmPasswordInput">
                                        <i class="fa fa-eye text-muted"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>

                            <button type="submit" class="btn btn-theme-primary w-100 fw-semibold py-2">
                                <i class="fa fa-save me-2"></i> Cập nhật mật khẩu
                            </button>
                        </form>

                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
