@using Microsoft.AspNetCore.Identity
@using SmartShop.Models
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager
@inject SmartShop.Data.Repository.IRepository.IUnitOfWork _cartUow

@if (SignInManager.IsSignedIn(User))
{
    var user = await UserManager.GetUserAsync(User);
    var isAdmin = User.IsInRole("Admin");

    var cartCount = 0;
    if (user != null)
    {
        var userCart = await _cartUow.Carts.GetByUserIdAsync(user.Id);
        if (userCart != null)
            cartCount = await _cartUow.CartItems.CountAsync(ci => ci.CartId == userCart.CartId);
    }

    <li class="nav-item ms-2">
        <a class="nav-link cart-nav-link" asp-area="Customers" asp-controller="Cart" asp-action="Index"
           title="Giỏ hàng">
            <i class="fa fa-shopping-cart"></i>
            @if (cartCount > 0)
            {
                <span class="cart-badge">@cartCount</span>
            }
        </a>
    </li>

    <li class="nav-item dropdown ms-2">
        <!-- Avatar tròn - căn chỉnh với navbar -->
        <a class="nav-link dropdown-toggle d-flex align-items-center p-0" href="#"
           id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <div class="user-avatar rounded-circle bg-primary d-flex align-items-center
                        justify-content-center text-white"
                 style="width:36px;height:36px;font-size:16px;">
                @if (!string.IsNullOrEmpty(user?.AvatarUrl))
                {
                    <img src="@user.AvatarUrl" class="rounded-circle" width="36" height="36" alt="avatar" />
                }
                else
                {
                    <i class="fa fa-user"></i>
                }
            </div>
        </a>

        <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0" style="min-width: 220px;">
            <!-- Header -->
            <li class="dropdown-header px-3 py-2 bg-light">
                <div class="fw-bold text-dark">@user?.FullName</div>
                <small class="text-muted">@user?.Email</small>
            </li>
            <li><hr class="dropdown-divider my-1" /></li>
            
            <!-- Menu Items - FA 4.0.3 VALID icons -->
            <li>
                <a class="dropdown-item d-flex align-items-center py-2 px-3"
                   asp-area="" asp-controller="Account" asp-action="Orders">
                    <i class="fa fa-shopping-cart me-3 text-muted" style="width: 16px; text-align: center;"></i>
                    <span>Đơn hàng của tôi</span>
                </a>
            </li>
            <li>
                <a class="dropdown-item d-flex align-items-center py-2 px-3" 
                   asp-area="" asp-controller="Account" asp-action="Addresses">
                    <i class="fa fa-map-marker me-3 text-muted" style="width: 16px; text-align: center;"></i>
                    <span>Địa chỉ</span>
                </a>
            </li>
            <li>
                <a class="dropdown-item d-flex align-items-center py-2 px-3" 
                   asp-area="" asp-controller="Account" asp-action="Profile">
                    <i class="fa fa-user me-3 text-muted" style="width: 16px; text-align: center;"></i>
                    <span>Tài khoản</span>
                </a>
            </li>

            @if (isAdmin)
            {
                <li><hr class="dropdown-divider my-1" /></li>
                <li>
                    <a class="dropdown-item d-flex align-items-center py-2 px-3 text-primary fw-semibold"
                       asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                        <i class="fa fa-cog me-3" style="width: 16px; text-align: center;"></i>
                        <span>Quản lý</span>
                    </a>
                </li>
            }

            <li><hr class="dropdown-divider my-1" /></li>
            <li>
                <form asp-area="" asp-controller="Auth" asp-action="Logout" method="post" class="m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="dropdown-item d-flex align-items-center py-2 px-3 text-danger">
                        <i class="fa fa-sign-out me-3" style="width: 16px; text-align: center;"></i>
                        <span>Đăng xuất</span>
                    </button>
                </form>
            </li>
        </ul>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link" asp-area="" asp-controller="Auth" asp-action="Login">Đăng nhập</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" asp-area="" asp-controller="Auth" asp-action="Register">Đăng ký</a>
    </li>
}