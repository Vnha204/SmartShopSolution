@using Microsoft.AspNetCore.Identity
@using SmartShop.Models
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager
@{
    var currentUser = await UserManager.GetUserAsync(User);
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — SmartShop Admin</title>

    <!-- Bootstrap 5 -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <!-- Admin Layout -->
    <link rel="stylesheet" href="~/css/admin-layout.css" asp-append-version="true" />
</head>
<body>
    <div class="admin-wrapper">

        <!-- ===== SIDEBAR ===== -->
        <aside class="admin-sidebar" id="adminSidebar">

            <!-- Brand -->
            <div class="sidebar-brand">
                <img src="~/images/logo.png" alt="SmartShop" onerror="this.style.display='none'" />
                <span>SmartShop</span>
            </div>

            <!-- User info -->
            <div class="sidebar-user">
                <div class="avatar">
                    @if (!string.IsNullOrEmpty(currentUser?.AvatarUrl))
                    {
                        <img src="@currentUser.AvatarUrl" style="width:38px;height:38px;border-radius:50%;object-fit:cover;" />
                    }
                    else
                    {
                        <i class="fa fa-user"></i>
                    }
                </div>
                <div class="info">
                    <div class="name">@(currentUser?.FullName ?? "Admin")</div>
                    <span class="role">Admin</span>
                </div>
            </div>

            <!-- Nav -->
            <nav class="sidebar-nav">
                <div class="nav-section-title">Tổng quan</div>
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
                           class="@(currentController == "Dashboard" ? "active" : "")">
                            <i class="fa fa-tachometer"></i> Dashboard
                        </a>
                    </li>
                </ul>

                @* (file head/body unchanged above) *@

                <div class="nav-section-title">Quản lý</div>
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a asp-area="Admin" asp-controller="Product" asp-action="Index"
                           class="@(currentController == "Product" ? "active" : "")">
                            <i class="fa fa-shopping-bag"></i> Sản phẩm
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-area="Admin" asp-controller="Category" asp-action="Index"
                           class="@(currentController == "Category" ? "active" : "")">
                            <i class="fa fa-tags"></i> Danh mục
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-area="Admin" asp-controller="Attribute" asp-action="Index"
                           class="@(currentController == "Attribute" ? "active" : "")">
                            <i class="fa fa-list-alt"></i> Thuộc tính
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-area="Admin" asp-controller="CategoryAttribute" asp-action="Index"
                           class="@(currentController == "CategoryAttribute" ? "active" : "")">
                            <i class="fa fa-link"></i> Ánh xạ thuộc tính
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-area="Admin" asp-controller="Order" asp-action="Index"
                           class="@(currentController == "Order" ? "active" : "")">
                            <i class="fa fa-shopping-cart"></i> Đơn hàng
                        </a>
                    </li>
                    <li class="nav-item">
                        <a asp-area="Admin" asp-controller="Member" asp-action="Index"
                           class="@(currentController == "Member" ? "active" : "")">
                            <i class="fa fa-users"></i> Thành viên
                        </a>
                    </li>
                </ul>

                @* remainder of file unchanged *@

                <div class="nav-section-title">Khác</div>
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a asp-area="Customers" asp-controller="Home" asp-action="Index" target="_blank">
                            <i class="fa fa-external-link"></i> Xem trang web
                        </a>
                    </li>
                </ul>
            </nav>

            <!-- Footer logout -->
            <div class="sidebar-footer">
                <form asp-controller="Auth" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit">
                        <i class="fa fa-sign-out"></i> Đăng xuất
                    </button>
                </form>
            </div>
        </aside>
        <!-- ===== END SIDEBAR ===== -->
        <!-- ===== MAIN ===== -->
        <div class="admin-main">

            <!-- Topbar -->
            <div class="admin-topbar">
                <div>
                    <h5 class="page-title">@(ViewData["Title"] ?? "Admin")</h5>
                </div>
                <div class="topbar-actions">
                    <a asp-area="Customers" asp-controller="Home" asp-action="Index"
                       class="btn-home" target="_blank">
                        <i class="fa fa-home"></i> Trang chủ
                    </a>
                    <span class="text-muted small">@(currentUser?.Email ?? "")</span>
                </div>
            </div>

            <!-- Toast alerts (TempData) -->
            @if (TempData["Success"] != null)
            {
                <div class="admin-toast-area">
                    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                        <i class="fa fa-check-circle me-2"></i> @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="admin-toast-area">
                    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                        <i class="fa fa-exclamation-circle me-2"></i> @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                </div>
            }

            <!-- Page content -->
            <main class="admin-content">
                @RenderBody()
            </main>
        </div>
        <!-- ===== END MAIN ===== -->

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/admin.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>