@model IEnumerable<SmartShop.Models.Order>

<div class="card card-custom">
    <div class="card-header bg-white border-bottom py-3">
        <h5 class="mb-0 fw-bold">
            <i class="fa fa-shopping-bag me-2 text-primary-custom"></i> Đơn hàng của tôi
        </h5>
    </div>
    <div class="card-body p-4">
        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="fa fa-shopping-bag fa-3x mb-3 d-block" style="opacity:0.3;"></i>
                <p>Bạn chưa có đơn hàng nào.</p>
                <a asp-area="Customers" asp-controller="Shop" asp-action="Index"
                   class="btn btn-primary-custom px-4">
                    <i class="fa fa-shopping-cart me-2"></i> Duyệt sản phẩm
                </a>
            </div>
        }
        else
        {
            <div class="orders-list">
                @foreach (var order in Model)
                {
                    <div class="border rounded-3 p-3 mb-3 order-item">
                        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                            <div>
                                <span class="fw-bold">#@order.OrderCode</span>
                                <span class="badge ms-2 @StatusBadgeHelper.GetOrderStatusBadge(order.Status)">
                                    @OrderStatus.DisplayNames.GetValueOrDefault(order.Status, order.Status)
                                </span>
                            </div>
                            <span class="text-muted small">
                                <i class="fa fa-calendar me-1"></i>
                                @order.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                            </span>
                        </div>
                        <div class="mt-2 d-flex justify-content-between align-items-center">
                            <span class="text-muted small">
                                <i class="fa fa-cube me-1"></i>
                                @order.OrderItems.Count sản phẩm
                            </span>
                            <span class="fw-bold text-success">
                                @order.TotalPrice.ToString("N0") ₫
                            </span>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>