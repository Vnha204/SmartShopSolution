@model SmartShop.Models.Address

<div class="border rounded-3 p-3 mb-3 address-item @(Model.IsDefault ? "border-primary address-card-default" : "")">
    <div class="d-flex justify-content-between align-items-start">
        <div class="flex-grow-1">
            <div class="fw-semibold d-flex align-items-center gap-2">
                <i class="fa fa-user text-muted"></i>
                @Model.FullName
                <span class="badge bg-primary badge-xs address-default-badge @(Model.IsDefault ? "" : "d-none")">Mặc định</span>
            </div>
            <div class="text-muted small mt-1">
                <i class="fa fa-phone me-1"></i> @Model.PhoneNumber
            </div>
            <div class="text-muted small mt-1">
                <i class="fa fa-map-marker me-1"></i>
                @Model.StreetLine, @Model.Ward, @Model.District, @Model.Province
            </div>
        </div>
        <div class="d-flex gap-2 flex-shrink-0">
            <button type="button" class="btn btn-sm btn-set-default @(Model.IsDefault ? "is-default" : "")"
                    data-id="@Model.Id" title="Đặt mặc định">
                <i class="fa @(Model.IsDefault ? "fa-check-circle" : "fa-check-circle-o")"></i>
            </button>
            <button type="button" class="btn btn-sm btn-outline-danger delete-address-btn"
                    data-id="@Model.Id" title="Xóa">
                <i class="fa fa-trash-o"></i>
            </button>
        </div>
    </div>
</div>
