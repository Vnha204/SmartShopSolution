@using Microsoft.AspNetCore.Identity
@using SmartShop.Models
@inject UserManager<AppUser> UserManager

@{
    var user = await UserManager.GetUserAsync(User);
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Profile";
}

<div class="card card-custom account-sidebar-card">
    <div class="card-body p-0">
        <!-- User header -->
        <div class="text-center p-4 border-bottom account-header"
             style="background: linear-gradient(135deg, var(--primary-color), var(--primary-hover)); border-radius: var(--border-radius) var(--border-radius) 0 0;">
            <div class="mx-auto mb-2 d-flex align-items-center justify-content-center rounded-circle bg-white"
                 style="width:60px;height:60px;font-size:26px;color:var(--primary-color);">
                <i class="fa fa-user"></i>
            </div>
            <p class="fw-bold mb-0 text-white">@user?.FullName</p>
            <small class="text-white-50">@user?.Email</small>
        </div>

        <!-- Navigation - AJAX Tabs (FontAwesome 4.0.3 VALID icons) -->
        <div class="list-group list-group-flush account-nav" id="accountNav">
            <a href="javascript:void(0)" 
               class="list-group-item list-group-item-action border-0 d-flex align-items-center account-tab @(currentAction == "Profile" ? "active" : "")"
               data-tab="profile" 
               data-url="@Url.Action("ProfilePartial", "Account")">
                <i class="fa fa-user" style="width: 20px; text-align: center;"></i>
                <span class="ms-2">Tài khoản</span>
            </a>
            <a href="javascript:void(0)" 
               class="list-group-item list-group-item-action border-0 d-flex align-items-center account-tab @(currentAction == "Orders" ? "active" : "")"
               data-tab="orders" 
               data-url="@Url.Action("OrdersPartial", "Account")">
                <!-- FA 4.0.3: Dùng fa-shopping-cart thay vì fa-shopping-bag -->
                <i class="fa fa-shopping-cart" style="width: 20px; text-align: center;"></i>
                <span class="ms-2">Đơn hàng</span>
            </a>
            <a href="javascript:void(0)" 
               class="list-group-item list-group-item-action border-0 d-flex align-items-center account-tab @(currentAction == "Addresses" ? "active" : "")"
               data-tab="addresses" 
               data-url="@Url.Action("AddressesPartial", "Account")">
                <i class="fa fa-map-marker" style="width: 20px; text-align: center;"></i>
                <span class="ms-2">Địa chỉ</span>
            </a>
            <hr class="my-0" />
            <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0">
                @Html.AntiForgeryToken()
                <button type="submit"
                        class="list-group-item list-group-item-action border-0 text-danger d-flex align-items-center w-100 text-start bg-transparent">
                    <i class="fa fa-sign-out" style="width: 20px; text-align: center;"></i>
                    <span class="ms-2">Đăng xuất</span>
                </button>
            </form>
        </div>
    </div>
</div>