@using Microsoft.AspNetCore.Identity
@using SmartShop.Models
@inject UserManager<AppUser> UserManager

@{
    Layout = "_Layout";
    var user = await UserManager.GetUserAsync(User);
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Profile";
}

<section class="inner_page position_head account-page-section">
    <div class="container my-5">
        <div class="row">
            <!-- sidebar -->
            <div class="col-lg-3 col-md-4 mb-4">
                <div class="card card-custom account-sidebar-card">
                    <div class="card-body p-0">
                        <!-- tiêu đề người dùng -->
                        <div class="text-center p-4 border-bottom account-header"
                             style="background: linear-gradient(135deg, var(--primary-color), var(--primary-hover)); border-radius: var(--border-radius) var(--border-radius) 0 0;">
                            <div class="mx-auto mb-2 d-flex align-items-center justify-content-center rounded-circle bg-white"
                                 style="width:60px;height:60px;font-size:26px;color:var(--primary-color);">
                                @if (!string.IsNullOrEmpty(user?.AvatarUrl))
                                {
                                    <img src="@user.AvatarUrl" class="rounded-circle" width="60" height="60" alt="avatar" />
                                }
                                else
                                {
                                    <i class="fa fa-user"></i>
                                }
                            </div>
                            <p class="fw-bold mb-0 text-white">@user?.FullName</p>
                            <small class="text-white-50">@user?.Email</small>
                        </div>

                        <!-- tab điều hướng -->
                        <div class="list-group list-group-flush account-nav" id="accountNav">
                            <a href="javascript:void(0)"
                               class="list-group-item list-group-item-action border-0 d-flex align-items-center gap-3 account-tab @(currentAction == "Profile" ? "active" : "")"
                               data-tab="profile"
                               data-url="@Url.Action("ProfilePartial", "Account")">
                                <i class="fa fa-user" style="width: 18px; text-align: center;"></i>
                                <span>Tài khoản</span>
                            </a>
                            <a href="javascript:void(0)"
                               class="list-group-item list-group-item-action border-0 d-flex align-items-center gap-3 account-tab @(currentAction == "Orders" || currentAction == "OrderDetail" ? "active" : "")"
                               data-tab="orders"
                               data-url="@Url.Action("OrdersPartial", "Account")">
                                <i class="fa fa-shopping-cart" style="width: 18px; text-align: center;"></i>
                                <span>Đơn hàng</span>
                            </a>
                            <a href="javascript:void(0)"
                               class="list-group-item list-group-item-action border-0 d-flex align-items-center gap-3 account-tab @(currentAction == "Addresses" ? "active" : "")"
                               data-tab="addresses"
                               data-url="@Url.Action("AddressesPartial", "Account")">
                                <i class="fa fa-map-marker" style="width: 18px; text-align: center;"></i>
                                <span>Địa chỉ</span>
                            </a>
                            <hr class="my-0" />
                            <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <button type="submit"
                                        class="list-group-item list-group-item-action border-0 text-danger d-flex align-items-center gap-3 w-100 text-start bg-transparent">
                                    <i class="fa fa-sign-out" style="width: 18px; text-align: center;"></i>
                                    <span>Đăng xuất</span>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <!-- nội dung chính -->
            <div class="col-lg-9 col-md-8">
                <div id="account-content" class="account-content-area">
                    <div id="account-content-inner">
                        @RenderBody()
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
