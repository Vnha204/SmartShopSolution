<script>
$(document).ready(function () {
    // AJAX Tab Navigation - Không reload trang, không spinner
    $('#accountNav').on('click', '.account-tab', function (e) {
        e.preventDefault();
        e.stopPropagation();

        var $this = $(this);
        var url = $this.data('url');
        var tabName = $this.data('tab');

        // Nếu đã active thì không làm gì
        if ($this.hasClass('active')) return;

        // Cập nhật trạng thái active ngay lập tức
        $('.account-tab').removeClass('active');
        $this.addClass('active');

        // Load nội dung qua AJAX - KHÔNG HIỆN SPINNER
        $.ajax({
            url: url,
            type: 'GET',
            cache: false,
            success: function (data) {
                // Cập nhật content trực tiếp, không fade
                $('#account-content-inner').html(data);

                // Cập nhật URL trên browser (không reload)
                var newUrl = '/Account';
                if (tabName === 'orders') newUrl = '/Account/Orders';
                else if (tabName === 'addresses') newUrl = '/Account/Addresses';
                else newUrl = '/Account/Profile';
                
                history.pushState({ tab: tabName }, '', newUrl);

                // Cập nhật title
                var titles = {
                    'profile': 'Tài khoản của tôi',
                    'orders': 'Đơn hàng của tôi',
                    'addresses': 'Địa chỉ của tôi'
                };
                document.title = titles[tabName] + ' - SmartShop';

                // Re-init Bootstrap components nếu cần
                initBootstrapComponents();
            },
            error: function (xhr) {
                $('#account-content-inner').html(
                    '<div class="alert alert-danger m-3">' +
                    '<i class="fa fa-exclamation-circle me-2"></i>' +
                    'Không thể tải nội dung. Vui lòng thử lại.' +
                    '</div>'
                );
            }
        });
    });

    // Handle browser back/forward buttons
    window.addEventListener('popstate', function (e) {
        if (e.state && e.state.tab) {
            var $tab = $('.account-tab[data-tab="' + e.state.tab + '"]');
            if ($tab.length && !$tab.hasClass('active')) {
                $tab.trigger('click');
            }
        }
    });

    // Initialize Bootstrap components after AJAX load
    function initBootstrapComponents() {
        var tooltips = document.querySelectorAll('[data-bs-toggle="tooltip"]');
        tooltips.forEach(function(el) {
            new bootstrap.Tooltip(el);
        });
    }
});
</script>