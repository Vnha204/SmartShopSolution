@model IEnumerable<SmartShop.Models.Address>
@{
    ViewData["Title"] = "Địa chỉ của tôi";
    Layout = "_Layout";
}

<section class="inner_page position_head">
    <div class="container my-5">
        <div class="row">

            {{! ===== SIDEBAR ===== }}
            <div class="col-md-3 mb-4">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-body p-0">
                        <div class="list-group list-group-flush">
                            <a asp-controller="Account" asp-action="Profile"
                               class="list-group-item list-group-item-action border-0 d-flex align-items-center gap-2">
                                <i class="fa fa-user-circle text-muted"></i> Tài khoản
                            </a>
                            <a asp-controller="Account" asp-action="Orders"
                               class="list-group-item list-group-item-action border-0 d-flex align-items-center gap-2">
                                <i class="fa fa-shopping-bag text-muted"></i> Đơn hàng
                            </a>
                            <a asp-controller="Account" asp-action="Addresses"
                               class="list-group-item list-group-item-action active border-0 d-flex align-items-center gap-2">
                                <i class="fa fa-map-marker text-primary"></i> Địa chỉ
                            </a>
                            <form asp-controller="Auth" asp-action="Logout" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit"
                                        class="list-group-item list-group-item-action border-0 text-danger d-flex align-items-center gap-2 w-100 text-start bg-transparent">
                                    <i class="fa fa-sign-out"></i> Đăng xuất
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            {{! ===== CONTENT ===== }}
            <div class="col-md-9">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                        <h5 class="mb-0 fw-bold">
                            <i class="fa fa-map-marker me-2 text-primary"></i> Địa chỉ giao hàng
                        </h5>
                        <button class="btn btn-sm text-white px-3"
                                style="background:#3498db; border:none; border-radius:6px;"
                                data-bs-toggle="modal" data-bs-target="#addAddressModal">
                            <i class="fa fa-plus me-1"></i> Thêm địa chỉ
                        </button>
                    </div>
                    <div class="card-body p-4">

                        @if (TempData["Success"] != null)
                        {
                            <div class="alert alert-success alert-dismissible fade show py-2 small">
                                <i class="fa fa-check-circle me-2"></i> @TempData["Success"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        }

                        @if (!Model.Any())
                        {
                            <div class="text-center py-5 text-muted">
                                <i class="fa fa-map-marker fa-3x mb-3 d-block" style="opacity:0.3;"></i>
                                <p>Bạn chưa có địa chỉ nào.</p>
                                <button class="btn btn-sm px-4 text-white"
                                        style="background:#3498db; border:none; border-radius:6px;"
                                        data-bs-toggle="modal" data-bs-target="#addAddressModal">
                                    Thêm địa chỉ đầu tiên
                                </button>
                            </div>
                        }
                        else
                        {
                            @foreach (var address in Model)
                            {
                                <div class="border rounded-3 p-3 mb-3 @(address.IsDefault ? "border-primary bg-primary bg-opacity-5" : "")">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <div class="fw-semibold">
                                                @address.FullName
                                                @if (address.IsDefault)
                                                {
                                                    <span class="badge ms-2"
                                                          style="background:#3498db; font-size:10px;">Mặc định</span>
                                                }
                                            </div>
                                            <div class="text-muted small mt-1">
                                                <i class="fa fa-phone me-1"></i> @address.PhoneNumber
                                            </div>
                                            <div class="text-muted small mt-1">
                                                <i class="fa fa-map-marker me-1"></i>
                                                @address.StreetLine, @address.Ward, @address.District, @address.Province
                                            </div>
                                        </div>
                                        <div class="d-flex gap-2">
                                            <button class="btn btn-sm btn-outline-secondary" disabled title="Sửa (coming soon)">
                                                <i class="fa fa-pencil"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                        }

                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

{{! ===== MODAL THÊM ĐỊA CHỈ ===== }}
<div class="modal fade" id="addAddressModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold">
                    <i class="fa fa-map-marker me-2 text-primary"></i> Thêm địa chỉ mới
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Account" asp-action="AddAddress" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Họ và tên người nhận</label>
                            <input type="text" name="FullName" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Số điện thoại</label>
                            <input type="tel" name="PhoneNumber" class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">Tỉnh / Thành phố</label>
                            <input type="text" name="Province" class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">Quận / Huyện</label>
                            <input type="text" name="District" class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold small">Phường / Xã</label>
                            <input type="text" name="Ward" class="form-control" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold small">Địa chỉ cụ thể (số nhà, tên đường)</label>
                            <input type="text" name="StreetLine" class="form-control" required
                                   placeholder="VD: 123 Lê Lợi" />
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input type="checkbox" name="IsDefault" value="true"
                                       class="form-check-input" id="isDefaultCheck" />
                                <label class="form-check-label small" for="isDefaultCheck">
                                    Đặt làm địa chỉ mặc định
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Huỷ</button>
                    <button type="submit" class="btn text-white px-4"
                            style="background:#3498db; border:none; border-radius:6px;">
                        <i class="fa fa-save me-1"></i> Lưu địa chỉ
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>