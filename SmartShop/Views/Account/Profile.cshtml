@model SmartShop.Models.AppUser
@{
    ViewData["Title"] = "Tài khoản của tôi";
    Layout = "_Layout";
}

<section class="inner_page position_head">
    <div class="container my-5">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-lg-3 col-md-4 mb-4">
                <partial name="_AccountSidebar" />
            </div>

            <!-- Main Content Area - AJAX Loaded -->
            <div class="col-lg-9 col-md-8">
                <div id="account-content" class="account-content-area">
                    <!-- Content - Không cần loading spinner -->
                    <div id="account-content-inner">
                        <partial name="_ProfilePartial" model="Model" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_AccountAjaxScript" />
}