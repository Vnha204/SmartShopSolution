@model SmartShop.Models.Attribute
@{
    ViewData["Title"] = "Thêm thuộc tính";
    Layout = "_AdminLayout";
}

<div class="d-flex align-items-center mb-4 gap-3">
    <a asp-area="Admin" asp-controller="Attribute" asp-action="Index"
       class="btn btn-sm btn-outline-secondary">
        <i class="fa fa-arrow-left me-1"></i> Quay lại
    </a>
    <h4 class="mb-0 fw-bold">Thêm thuộc tính mới</h4>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="mb-0 fw-bold">
                    <i class="fa fa-info-circle me-2 text-primary"></i> Thông tin thuộc tính
                </h6>
            </div>
            <div class="card-body">
                <form asp-area="Admin" asp-controller="Attribute" asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold">
                            Tên nội bộ (Name) <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Name" class="form-control"
                               placeholder="vd: gender, material, style" />
                        <div class="form-text">Dùng chữ thường, không dấu, không khoảng trắng.</div>
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DisplayName" class="form-label fw-semibold">
                            Tên hiển thị <span class="text-danger">*</span>
                        </label>
                        <input asp-for="DisplayName" class="form-control"
                               placeholder="vd: Giới tính, Chất liệu, Kiểu dáng" />
                        <span asp-validation-for="DisplayName" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="SortOrder" class="form-label fw-semibold">Thứ tự hiển thị</label>
                        <input asp-for="SortOrder" class="form-control" type="number" min="0" />
                        <span asp-validation-for="SortOrder" class="text-danger small"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="fa fa-save me-2"></i> Lưu thuộc tính
                        </button>
                        <a asp-area="Admin" asp-controller="Attribute" asp-action="Index"
                           class="btn btn-outline-secondary">Huỷ</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
