@model SmartShop.Models.Attribute
@{
    ViewData["Title"] = "Xoá thuộc tính";
    Layout = "_AdminLayout";

    var usedByProducts = Model.Values.Sum(v => v.ProductAttributeValues.Count);
}

<div class="d-flex align-items-center mb-4 gap-3">
    <a asp-area="Admin" asp-controller="Attribute" asp-action="Index"
       class="btn btn-sm btn-outline-secondary">
        <i class="fa fa-arrow-left me-1"></i> Quay lại
    </a>
    <h4 class="mb-0 fw-bold">Xoá thuộc tính</h4>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm border-danger" style="border-color:#dc3545!important;">
            <div class="card-header bg-danger text-white py-3">
                <h6 class="mb-0 fw-bold">
                    <i class="fa fa-exclamation-triangle me-2"></i> Xác nhận xoá
                </h6>
            </div>
            <div class="card-body">
                <p>Bạn có chắc muốn xoá thuộc tính <strong>@Model.DisplayName</strong>
                    (<code>@Model.Name</code>) không?</p>

                <ul class="text-muted small mb-3">
                    <li>Số giá trị sẽ bị xoá: <strong>@Model.Values.Count</strong></li>
                    <li>Số sản phẩm bị ảnh hưởng: <strong>@usedByProducts</strong></li>
                    <li>Số danh mục áp dụng: <strong>@Model.CategoryAttributes.Count</strong></li>
                </ul>

                @if (usedByProducts > 0)
                {
                    <div class="alert alert-warning py-2 small">
                        <i class="fa fa-warning me-1"></i>
                        Thuộc tính này đang được gán cho <strong>@usedByProducts</strong> sản phẩm.
                        Xoá sẽ xoá luôn các giá trị đó khỏi sản phẩm.
                    </div>
                }

                <form asp-area="Admin" asp-controller="Attribute" asp-action="Delete"
                      asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-danger">
                            <i class="fa fa-trash me-2"></i> Xoá thuộc tính
                        </button>
                        <a asp-area="Admin" asp-controller="Attribute" asp-action="Index"
                           class="btn btn-outline-secondary">Huỷ</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
