@model IEnumerable<SmartShop.Models.Category>
@{
    ViewData["Title"] = "Quản lý danh mục";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1 fw-bold">Danh mục</h4>
        <p class="text-muted small mb-0">Tổng: @Model.Count() danh mục</p>
    </div>
    <a asp-area="Admin" asp-controller="Category" asp-action="Create"
       class="btn btn-theme-primary px-4">
        <i class="fa fa-plus me-2"></i> Thêm danh mục
    </a>
</div>

<!-- thanh tìm kiếm -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body py-3">
        <div class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0">
                        <i class="fa fa-search text-muted"></i>
                    </span>
                    <input type="text" id="searchInput" class="form-control border-start-0"
                           placeholder="Tìm theo tên danh mục..." onkeyup="searchCategories()" />
                </div>
            </div>
            <div class="col-md-3">
                <select class="form-select" id="statusFilter" onchange="filterByStatus()">
                    <option value="all">Tất cả trạng thái</option>
                    <option value="active">Đang hiển thị</option>
                    <option value="inactive">Ẩn</option>
                </select>
            </div>
            <div class="col-md-4 text-end text-muted small">
                <i class="fa fa-info-circle me-1"></i>
                Hiển thị <span id="rowCount">@Model.Count()</span> / @Model.Count() danh mục
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table admin-table mb-0" id="categoryTable">
                <thead>
                    <tr>
                        <th style="width:50px;">ID</th>
                        <th>Tên danh mục</th>
                        <th>Slug</th>
                        <th>Danh mục cha</th>
                        <th>Thứ tự</th>
                        <th>Trạng thái</th>
                        <th>Ngày tạo</th>
                        <th style="width:100px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody id="categoryTableBody">
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="fa fa-tags fa-2x d-block mb-2" style="opacity:0.3;"></i>
                                Chưa có danh mục nào. Hãy thêm danh mục đầu tiên.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var cat in Model)
                        {
                            <tr data-name="@cat.Name.ToLower()"
                                data-status="@(cat.IsActive ? "active" : "inactive")">
                                <td class="text-muted small">@cat.Id</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        @if (!string.IsNullOrEmpty(cat.ImageUrl))
                                        {
                                            <img src="@cat.ImageUrl"
                                                 style="width:36px;height:36px;object-fit:cover;border-radius:6px;border:1px solid #eee;" />
                                        }
                                        else
                                        {
                                            <div style="width:36px;height:36px;background:#f0f2f5;border-radius:6px;display:flex;align-items:center;justify-content:center;">
                                                <i class="fa fa-tag text-muted" style="font-size:14px;"></i>
                                            </div>
                                        }
                                        <span class="fw-semibold small">
                                            @if (cat.ParentId != null)
                                            {
                                                <span class="text-muted me-1">↳</span>
                                            }
                                            @cat.Name
                                        </span>
                                    </div>
                                </td>
                                <td class="small text-muted"><code>@cat.Slug</code></td>
                                <td class="small">
                                    @if (cat.Parent != null)
                                    {
                                        <span class="badge bg-light text-dark border">@cat.Parent.Name</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-center small">@cat.SortOrder</td>
                                <td>
                                    <span class="badge @(cat.IsActive ? "bg-success" : "bg-secondary") badge-status">
                                        @(cat.IsActive ? "Hiển thị" : "Ẩn")
                                    </span>
                                </td>
                                <td class="small text-muted">@cat.CreatedAt.ToString("HH:mm, dd/MM/yyyy")</td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <a asp-area="Admin" asp-controller="Category" asp-action="Edit"
                                           asp-route-id="@cat.Id"
                                           class="btn btn-sm btn-outline-primary" title="Sửa">
                                            <i class="fa fa-pencil"></i>
                                        </a>
                                        <a asp-area="Admin" asp-controller="Category" asp-action="Delete"
                                           asp-route-id="@cat.Id"
                                           class="btn btn-sm btn-outline-danger" title="Xoá">
                                            <i class="fa fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function searchCategories() {
            const q = document.getElementById('searchInput').value.toLowerCase();
            const status = document.getElementById('statusFilter').value;
            filterTable(q, status);
        }

        function filterByStatus() {
            const q = document.getElementById('searchInput').value.toLowerCase();
            const status = document.getElementById('statusFilter').value;
            filterTable(q, status);
        }

        function filterTable(q, status) {
            const rows = document.querySelectorAll('#categoryTableBody tr[data-name]');
            let visible = 0;
            rows.forEach(row => {
                const nameMatch = row.dataset.name.includes(q);
                const statusMatch = status === 'all' || row.dataset.status === status;
                const show = nameMatch && statusMatch;
                row.style.display = show ? '' : 'none';
                if (show) visible++;
            });
            document.getElementById('rowCount').textContent = visible;
        }
    </script>
}
