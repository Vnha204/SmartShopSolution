@model SmartShop.Models.Category
@{
    ViewData["Title"] = "Xoá danh mục";
    Layout = "_AdminLayout";
}

<div class="d-flex align-items-center mb-4 gap-3">
    <a asp-area="Admin" asp-controller="Category" asp-action="Index"
       class="btn btn-sm btn-outline-secondary">
        <i class="fa fa-arrow-left me-1"></i> Quay lại
    </a>
    <h4 class="mb-0 fw-bold text-danger">Xoá danh mục</h4>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <div class="mb-3">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" alt="@Model.Name"
                             style="width:80px;height:80px;object-fit:cover;border-radius:8px;border:1px solid #eee;" />
                    }
                    else
                    {
                        <div style="width:80px;height:80px;background:#f5f5f5;border-radius:8px;display:flex;align-items:center;justify-content:center;margin:0 auto;">
                            <i class="fa fa-tags fa-2x text-muted"></i>
                        </div>
                    }
                </div>

                <h5 class="fw-bold">@Model.Name</h5>
                <p class="text-muted small mb-1">Slug: <code>@Model.Slug</code></p>

                @if (Model.Parent != null)
                {
                    <p class="text-muted small mb-1">Danh mục cha: <strong>@Model.Parent.Name</strong></p>
                }

                @if (Model.Children.Any())
                {
                    <div class="alert alert-warning py-2 small text-start mt-3 mb-3">
                        <i class="fa fa-exclamation-triangle me-2"></i>
                        Danh mục này có <strong>@Model.Children.Count danh mục con</strong>.
                        Vui lòng xoá hoặc chuyển các danh mục con trước khi xoá.
                    </div>
                    <a asp-area="Admin" asp-controller="Category" asp-action="Index"
                       class="btn btn-secondary px-4">
                        Quay lại
                    </a>
                }
                else
                {
                    <div class="alert alert-danger py-2 small text-start mt-3 mb-4">
                        <i class="fa fa-exclamation-triangle me-2"></i>
                        Bạn có chắc chắn muốn xoá danh mục này? Hành động này <strong>không thể hoàn tác</strong>.
                    </div>

                    <form asp-area="Admin" asp-controller="Category" asp-action="Delete"
                          asp-route-id="@Model.Id" method="post" class="d-flex gap-2 justify-content-center">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="fa fa-trash me-2"></i> Xác nhận xoá
                        </button>
                        <a asp-area="Admin" asp-controller="Category" asp-action="Index"
                           class="btn btn-outline-secondary px-4">
                            Huỷ
                        </a>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
