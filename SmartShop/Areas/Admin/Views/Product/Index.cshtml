@model IEnumerable<SmartShop.Models.Product>
@{
    ViewData["Title"] = "Quản lý sản phẩm";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1 fw-bold">Sản phẩm</h4>
        <p class="text-muted small mb-0">Tổng: @Model.Count() sản phẩm</p>
    </div>
    <a href="#" class="btn text-white px-4"
       style="background:#3498db; border:none; border-radius:8px;">
        <i class="fa fa-plus me-2"></i> Thêm sản phẩm
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show py-2 small">
        <i class="fa fa-check-circle me-2"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Search & Filter bar -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body py-3">
        <div class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0">
                        <i class="fa fa-search text-muted"></i>
                    </span>
                    <input type="text" id="searchInput" class="form-control border-start-0"
                           placeholder="Tìm theo tên sản phẩm..." onkeyup="searchProducts()" />
                </div>
            </div>
            <div class="col-md-3">
                <select class="form-select" id="statusFilter" onchange="filterByStatus()">
                    <option value="all">Tất cả trạng thái</option>
                    <option value="active">Đang bán</option>
                    <option value="inactive">Ngừng bán</option>
                </select>
            </div>
            <div class="col-md-4 text-end text-muted small">
                <i class="fa fa-info-circle me-1"></i>
                Hiển thị <span id="rowCount">@Model.Count()</span> / @Model.Count() sản phẩm
            </div>
        </div>
    </div>
</div>

<!-- Product table -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table admin-table mb-0" id="productTable">
                <thead>
                    <tr>
                        <th style="width:50px;">ID</th>
                        <th>Sản phẩm</th>
                        <th>Giá gốc</th>
                        <th>Giá KM</th>
                        <th>Kho</th>
                        <th>Trạng thái</th>
                        <th>Nổi bật</th>
                        <th>Ngày tạo</th>
                        <th style="width:100px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody id="productTableBody">
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="fa fa-shopping-bag fa-2x d-block mb-2" style="opacity:0.3;"></i>
                                Chưa có sản phẩm nào. Hãy thêm sản phẩm đầu tiên.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var product in Model)
                        {
                            <tr data-name="@product.Name.ToLower()"
                                data-status="@(product.IsActive ? "active" : "inactive")">
                                <td class="text-muted small">@product.Id</td>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        @if (!string.IsNullOrEmpty(product.ThumbnailUrl))
                                        {
                                            <img src="@product.ThumbnailUrl"
                                                 style="width:44px;height:44px;object-fit:contain;border-radius:6px;border:1px solid #eee;" />
                                        }
                                        else
                                        {
                                            <div style="width:44px;height:44px;background:#f5f5f5;border-radius:6px;display:flex;align-items:center;justify-content:center;">
                                                <i class="fa fa-image text-muted"></i>
                                            </div>
                                        }
                                        <div>
                                            <div class="fw-semibold small">@product.Name</div>
                                            <div class="text-muted" style="font-size:11px;">@product.Slug</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="small">@product.BasePrice.ToString("N0") ₫</td>
                                <td class="small">
                                    @if (product.SalePrice.HasValue)
                                    {
                                        <span class="text-success fw-semibold">@product.SalePrice.Value.ToString("N0") ₫</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge @(product.Stock > 0 ? "bg-success" : "bg-danger") badge-status">
                                        @product.Stock
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @(product.IsActive ? "bg-success" : "bg-secondary") badge-status">
                                        @(product.IsActive ? "Đang bán" : "Ngừng bán")
                                    </span>
                                </td>
                                <td>
                                    @if (product.IsFeatured)
                                    {
                                        <span class="badge" style="background:#f0a500; font-size:11px;">
                                            <i class="fa fa-star"></i> Nổi bật
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td class="small text-muted">
                                    @product.CreatedAt.ToString("dd/MM/yyyy")
                                </td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <a href="#" class="btn btn-sm btn-outline-primary" title="Sửa">
                                            <i class="fa fa-pencil"></i>
                                        </a>
                                        <a href="#" class="btn btn-sm btn-outline-danger" title="Xoá">
                                            <i class="fa fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>