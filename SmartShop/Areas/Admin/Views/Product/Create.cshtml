@model SmartShop.Models.ViewModels.ProductFormVM
@{
    ViewData["Title"] = "Thêm sản phẩm";
    Layout = "_AdminLayout";
}

<div class="d-flex align-items-center mb-4 gap-3">
    <a asp-area="Admin" asp-controller="Product" asp-action="Index"
       class="btn btn-sm btn-outline-secondary">
        <i class="fa fa-arrow-left me-1"></i> Quay lại
    </a>
    <h4 class="mb-0 fw-bold">Thêm sản phẩm mới</h4>
</div>

<form asp-area="Admin" asp-controller="Product" asp-action="Create"
      method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <div class="row g-4">

        <div class="col-lg-8">

            <!-- thông tin cơ bản -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h6 class="mb-0 fw-bold">
                        <i class="fa fa-info-circle me-2 text-primary"></i> Thông tin cơ bản
                    </h6>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold"></label>
                        <input asp-for="Name" class="form-control"
                               placeholder="Nhập tên sản phẩm..."
                               oninput="generateSlug(this.value)" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Slug" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text text-muted" style="font-size:12px;">/san-pham/</span>
                            <input asp-for="Slug" class="form-control" placeholder="slug-url-than-thien" />
                        </div>
                        <span asp-validation-for="Slug" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="Description" class="form-control" rows="5"
                                  placeholder="Mô tả chi tiết sản phẩm..."></textarea>
                    </div>
                </div>
            </div>

            <!-- giákho -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h6 class="mb-0 fw-bold">
                        <i class="fa fa-dollar me-2 text-success"></i> Giá & Kho hàng
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="BasePrice" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="BasePrice" class="form-control" type="number" min="0" step="1000" />
                                <span class="input-group-text">₫</span>
                            </div>
                            <span asp-validation-for="BasePrice" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="SalePrice" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="SalePrice" class="form-control" type="number" min="0" step="1000"
                                       placeholder="Để trống nếu không KM" />
                                <span class="input-group-text">₫</span>
                            </div>
                            <span asp-validation-for="SalePrice" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Stock" class="form-label fw-semibold"></label>
                            <input asp-for="Stock" class="form-control" type="number" min="0" />
                            <span asp-validation-for="Stock" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- hình ảnh -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h6 class="mb-0 fw-bold">
                        <i class="fa fa-image me-2 text-info"></i> Hình ảnh
                    </h6>
                </div>
                <div class="card-body">
                    <label class="form-label fw-semibold">Ảnh sản phẩm <span class="text-danger">*</span></label>
                    <input type="file" id="thumbnailFileInput" name="ThumbnailFile"
                           class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                    <div class="form-text text-muted">Định dạng: JPG, PNG, WebP. Tối đa 5 MB.</div>
                    <span asp-validation-for="ThumbnailFile" class="text-danger small"></span>
                    <div id="imgPreview" class="mt-2" style="display:none;">
                        <img id="previewImg" src="" alt="Preview"
                             style="max-height:180px;border-radius:8px;border:1px solid #eee;object-fit:contain;" />
                    </div>
                </div>
            </div>

            <div id="attributeCard" class="card border-0 shadow-sm mb-4" style="display:none;">
                <div class="card-header bg-white border-bottom py-3">
                    <h6 class="mb-0 fw-bold">
                        <i class="fa fa-check-square-o me-2 text-secondary"></i> Thuộc tính sản phẩm
                    </h6>
                </div>
                <div class="card-body">
                    <div id="attributeSection"></div>
                </div>
            </div>

        </div>

        <div class="col-lg-4">

            <!-- trạng thái -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h6 class="mb-0 fw-bold">
                        <i class="fa fa-toggle-on me-2 text-warning"></i> Trạng thái
                    </h6>
                </div>
                <div class="card-body">
                    <div class="form-check form-switch mb-3">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" />
                        <label asp-for="IsActive" class="form-check-label">Đang bán</label>
                    </div>
                    <div class="form-check form-switch">
                        <input asp-for="IsFeatured" class="form-check-input" type="checkbox" role="switch" />
                        <label asp-for="IsFeatured" class="form-check-label">Sản phẩm nổi bật</label>
                    </div>
                </div>
            </div>

            <!-- chọn danh mục -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h6 class="mb-0 fw-bold">
                        <i class="fa fa-tags me-2 text-primary"></i> Danh mục
                    </h6>
                </div>
                <div class="card-body">
                    <input type="hidden" asp-for="CategoryId" id="CategoryId" />
                    <span asp-validation-for="CategoryId" class="text-danger small d-block mb-2"></span>

                    <!-- dropdown danh mục -->
                    <div id="categoryChainContainer"></div>

                    <!-- breadcrumb khi chọn-->
                    <div id="leafDisplay" class="mt-2" style="display:none;">
                        <small class="text-success fw-semibold">
                            <i class="fa fa-check-circle me-1"></i>
                            <span id="leafBreadcrumb"></span>
                        </small>
                    </div>

                    <p class="text-muted small mt-2 mb-0">
                        <i class="fa fa-info-circle me-1"></i>
                        Chọn đến danh mục cấp cuối để hiển thị thuộc tính phù hợp.
                    </p>
                </div>
            </div>

            <!-- lưu -->
            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="fa fa-save me-2"></i> Lưu sản phẩm
                </button>
                <a asp-area="Admin" asp-controller="Product" asp-action="Index"
                   class="btn btn-outline-secondary">Huỷ</a>
            </div>

        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/admin-product-thumbnail.js"></script>
    <script src="~/js/admin/product-attributes.js" asp-append-version="true"></script>
    <script src="~/js/admin/product-create.js" asp-append-version="true"></script>
}
