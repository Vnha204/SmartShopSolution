@model SmartShop.Models.ViewModels.ProductFormVM
@{
    ViewData["Title"] = "Sửa sản phẩm";
    Layout = "_AdminLayout";

    var selectedIdsJson  = System.Text.Json.JsonSerializer.Serialize(Model.SelectedAttributeValueIds);
    var existingCatId    = Model.CategoryId.HasValue ? Model.CategoryId.Value.ToString() : "null";
    bool hasAttributes   = Model.AvailableAttributes.Any();
}

<div class="d-flex align-items-center mb-4 gap-3">
    <a asp-area="Admin" asp-controller="Product" asp-action="Index"
       class="btn btn-sm btn-outline-secondary">
        <i class="fa fa-arrow-left me-1"></i> Quay lại
    </a>
    <h4 class="mb-0 fw-bold">Sửa sản phẩm</h4>
</div>

<form asp-area="Admin" asp-controller="Product" asp-action="Edit"
      asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="row g-4">

        <div class="col-lg-8">

            <!-- thông tin cơ bản -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h6 class="mb-0 fw-bold">
                        <i class="fa fa-info-circle me-2 text-primary"></i> Thông tin cơ bản
                    </h6>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Slug" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text text-muted" style="font-size:12px;">/san-pham/</span>
                            <input asp-for="Slug" class="form-control" />
                        </div>
                        <span asp-validation-for="Slug" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                    </div>
                </div>
            </div>

            <!-- giá & kho -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h6 class="mb-0 fw-bold">
                        <i class="fa fa-dollar me-2 text-success"></i> Giá & Kho hàng
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="BasePrice" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="BasePrice" class="form-control" type="number" min="0" step="1000" />
                                <span class="input-group-text">₫</span>
                            </div>
                            <span asp-validation-for="BasePrice" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="SalePrice" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="SalePrice" class="form-control" type="number" min="0" step="1000"
                                       placeholder="Để trống nếu không KM" />
                                <span class="input-group-text">₫</span>
                            </div>
                            <span asp-validation-for="SalePrice" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Stock" class="form-label fw-semibold"></label>
                            <input asp-for="Stock" class="form-control" type="number" min="0" />
                            <span asp-validation-for="Stock" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- hình ảnh -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h6 class="mb-0 fw-bold">
                        <i class="fa fa-image me-2 text-info"></i> Hình ảnh
                    </h6>
                </div>
                <div class="card-body">
                    @* ảnh hiện tại *@
                    <div id="imgPreview" class="mb-3" style="@(string.IsNullOrEmpty(Model.ThumbnailUrl) ? "display:none;" : "")">
                        <p class="form-text text-muted mb-1">Ảnh hiện tại:</p>
                        <img id="previewImg" src="@(Model.ThumbnailUrl ?? "")" alt="Preview"
                             style="max-height:180px;border-radius:8px;border:1px solid #eee;object-fit:contain;" />
                    </div>

                    <label class="form-label fw-semibold">Thay ảnh mới <span class="text-muted fw-normal">(tùy chọn)</span></label>
                    <input type="file" id="thumbnailFileInput" name="ThumbnailFile"
                           class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                    <div class="form-text text-muted">Định dạng: JPG, PNG, WebP. Tối đa 5 MB. Để trống để giữ ảnh hiện tại.</div>
                    <span asp-validation-for="ThumbnailFile" class="text-danger small"></span>
                </div>
            </div>

            <div id="attributeCard" class="card border-0 shadow-sm mb-4"
                 style="@(hasAttributes ? "" : "display:none;")">
                <div class="card-header bg-white border-bottom py-3">
                    <h6 class="mb-0 fw-bold">
                        <i class="fa fa-check-square-o me-2 text-secondary"></i> Thuộc tính sản phẩm
                    </h6>
                </div>
                <div class="card-body">
                    <div id="attributeSection">
                        @* server-side render *@
                        @foreach (var attr in Model.AvailableAttributes)
                        {
                            <div class="mb-3" data-attribute-id="@attr.AttributeId">
                                <p class="fw-semibold mb-1">@attr.DisplayName</p>
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var opt in attr.Options)
                                    {
                                        var isChecked = Model.SelectedAttributeValueIds.Contains(opt.Id);
                                        <div class="form-check form-check-inline">
                                            <input class="form-check-input" type="checkbox"
                                                   name="SelectedAttributeValueIds" value="@opt.Id"
                                                   id="av_@opt.Id"
                                                   data-attribute-id="@attr.AttributeId"
                                                   data-value-id="@opt.Id"
                                                   checked="@(isChecked ? "checked" : null)" />
                                            <label class="form-check-label" for="av_@opt.Id">
                                                @opt.DisplayName
                                            </label>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

        </div>

        <div class="col-lg-4">

            <!-- trạng thái -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h6 class="mb-0 fw-bold">
                        <i class="fa fa-toggle-on me-2 text-warning"></i> Trạng thái
                    </h6>
                </div>
                <div class="card-body">
                    <div class="form-check form-switch mb-3">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" />
                        <label asp-for="IsActive" class="form-check-label">Đang bán</label>
                    </div>
                    <div class="form-check form-switch">
                        <input asp-for="IsFeatured" class="form-check-input" type="checkbox" role="switch" />
                        <label asp-for="IsFeatured" class="form-check-label">Sản phẩm nổi bật</label>
                    </div>
                </div>
            </div>

            <!-- chọn danh mục -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h6 class="mb-0 fw-bold">
                        <i class="fa fa-tags me-2 text-primary"></i> Danh mục
                    </h6>
                </div>
                <div class="card-body">
                    <input type="hidden" asp-for="CategoryId" id="CategoryId" />
                    <span asp-validation-for="CategoryId" class="text-danger small d-block mb-2"></span>

                    <div id="categoryChainContainer"></div>

                    <div id="leafDisplay" class="mt-2" style="display:none;">
                        <small class="text-success fw-semibold">
                            <i class="fa fa-check-circle me-1"></i>
                            <span id="leafBreadcrumb"></span>
                        </small>
                    </div>

                    <p class="text-muted small mt-2 mb-0">
                        <i class="fa fa-info-circle me-1"></i>
                        Đổi danh mục sẽ cập nhật lại danh sách thuộc tính.
                    </p>
                </div>
            </div>

            <!-- lưu -->
            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="fa fa-save me-2"></i> Lưu thay đổi
                </button>
                <a asp-area="Admin" asp-controller="Product" asp-action="Index"
                   class="btn btn-outline-secondary">Huỷ</a>
            </div>

        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/admin-product-thumbnail.js"></script>
    <script src="~/js/admin/product-attributes.js" asp-append-version="true"></script>
    <script>
    const CAT_API          = '/Admin/api/categories';
    const _existingCatId   = @Html.Raw(existingCatId);          
    const _existingSelIds  = @Html.Raw(selectedIdsJson);        
    let   _maxDepth        = 0;

    function removeDepthsFrom(fromDepth) {
        for (let d = fromDepth; d <= _maxDepth + 1; d++) {
            const el = document.getElementById('cat-level-' + d);
            if (el) el.remove();
        }
        _maxDepth = Math.max(fromDepth - 1, 0);
    }

    async function renderLevel(parentId, depth, preselectId) {
        removeDepthsFrom(depth);

        const url = parentId != null
            ? `${CAT_API}/children?parentId=${parentId}`
            : `${CAT_API}/children`;

        const resp       = await fetch(url);
        const categories = await resp.json();
        if (!categories.length) return;

        const container = document.getElementById('categoryChainContainer');
        const wrapper   = document.createElement('div');
        wrapper.id        = 'cat-level-' + depth;
        wrapper.className = 'mb-2';

        const label = document.createElement('small');
        label.className   = 'form-text text-muted mb-1 d-block';
        label.textContent = depth === 0 ? 'Danh mục gốc' : 'Danh mục con';
        wrapper.appendChild(label);

        const sel = document.createElement('select');
        sel.className        = 'form-select form-select-sm';
        sel.dataset.depth    = depth;
        sel.dataset.parentId = parentId ?? '';
        sel.addEventListener('change', function () { onLevelChange(this); });

        const ph       = document.createElement('option');
        ph.value       = '';
        ph.textContent = '-- Chọn --';
        sel.appendChild(ph);

        categories.forEach(c => {
            const opt               = document.createElement('option');
            opt.value               = c.id;
            opt.textContent         = c.name;
            opt.dataset.hasChildren = c.hasChildren ? '1' : '0';
            if (preselectId && c.id === preselectId) opt.selected = true;
            sel.appendChild(opt);
        });

        wrapper.appendChild(sel);
        const stale = document.getElementById(wrapper.id);
        if (stale) stale.remove();
        container.appendChild(wrapper);
        _maxDepth = Math.max(_maxDepth, depth);
    }

    async function onLevelChange(sel) {
        const depth      = parseInt(sel.dataset.depth);
        const categoryId = sel.value;

        removeDepthsFrom(depth + 1);
        clearLeaf();

        if (!categoryId) return;

        const opt         = sel.querySelector(`option[value="${categoryId}"]`);
        const hasChildren = opt && opt.dataset.hasChildren === '1';

        if (hasChildren) {
            await renderLevel(parseInt(categoryId), depth + 1, null);
        } else {
            const newCat = parseInt(categoryId);
            const text   = await fetchBreadcrumbText(newCat);
            setLeaf(newCat, text, []);  
        }
    }

    function setLeaf(categoryId, breadcrumbText, selectedIds) {
        document.getElementById('CategoryId').value = categoryId;
        document.getElementById('leafBreadcrumb').textContent = breadcrumbText;
        document.getElementById('leafDisplay').style.display = 'block';
        loadAttributes(categoryId, selectedIds);
    }

    function clearLeaf() {
        document.getElementById('CategoryId').value = '';
        document.getElementById('leafDisplay').style.display = 'none';
    }

    async function fetchBreadcrumbText(categoryId) {
        const resp = await fetch(`${CAT_API}/breadcrumb?categoryId=${categoryId}`);
        const bc   = await resp.json();
        return bc.map(b => b.name).join(' › ');
    }

    async function preloadCategoryChain(leafCategoryId) {
        const resp      = await fetch(`${CAT_API}/breadcrumb?categoryId=${leafCategoryId}`);
        const breadcrumb = await resp.json();
        if (!breadcrumb.length) return;

        // render cấp gốc, chọn trước mục đầu tiên
        await renderLevel(null, 0, breadcrumb[0].id);

        for (let i = 0; i < breadcrumb.length - 1; i++) {
            const item     = breadcrumb[i];
            const nextItem = breadcrumb[i + 1];
            await renderLevel(item.id, i + 1, nextItem.id);
        }

        const leaf = breadcrumb[breadcrumb.length - 1];
        document.getElementById('CategoryId').value = leaf.id;
        document.getElementById('leafBreadcrumb').textContent =
            breadcrumb.map(b => b.name).join(' › ');
        document.getElementById('leafDisplay').style.display = 'block';
    }

    async function loadAttributes(categoryId, selectedIds) {
        const card    = document.getElementById('attributeCard');
        const section = document.getElementById('attributeSection');
        try {
            const resp  = await fetch(`${CAT_API}/${categoryId}/attributes`);
            const attrs = await resp.json();
            renderAttributeCheckboxes(section, attrs, selectedIds);
            card.style.display = attrs.length > 0 ? 'block' : 'none';
        } catch (e) {
            console.error('Failed to load attributes', e);
        }
    }

    function renderAttributeCheckboxes(container, attrs, selectedIds) {
        if (!attrs || !attrs.length) {
            container.innerHTML =
                '<p class="text-muted small mb-0">Danh mục này chưa có thuộc tính nào được cấu hình.</p>';
            return;
        }
        let html = '';
        attrs.forEach(attr => {
            html += `<div class="mb-3" data-attribute-id="${attr.attributeId}">
                <p class="fw-semibold mb-1">${escHtml(attr.displayName)}</p>
                <div class="d-flex flex-wrap gap-2">`;
            attr.values.forEach(v => {
                const chk = (selectedIds.includes(v.id) || v.selected) ? ' checked' : '';
                html += `<div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox"
                           name="SelectedAttributeValueIds" value="${v.id}"
                           id="av_${v.id}" data-attribute-id="${attr.attributeId}"
                           data-value-id="${v.id}"${chk} />
                    <label class="form-check-label" for="av_${v.id}">
                        ${escHtml(v.displayName)}
                    </label>
                </div>`;
            });
            html += `</div></div>`;
        });
        container.innerHTML = html;
    }

    function escHtml(str) {
        const d = document.createElement('div');
        d.appendChild(document.createTextNode(str));
        return d.innerHTML;
    }

    document.addEventListener('DOMContentLoaded', async function () {
        if (_existingCatId) {
            // mở rộng chuỗi danh mục hiện có
            await preloadCategoryChain(_existingCatId);
        } else {
            await renderLevel(null, 0, null);
        }
    });
    </script>
}
