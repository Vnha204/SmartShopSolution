@model SmartShop.Models.ViewModels.ProductFormVM
@{
    ViewData["Title"] = "Sửa sản phẩm";
    Layout = "_AdminLayout";

    // Build a JS array of currently selected attribute value IDs for pre-selection
    var selectedIdsJson = System.Text.Json.JsonSerializer.Serialize(Model.SelectedAttributeValueIds);
}

<div class="d-flex align-items-center mb-4 gap-3">
    <a asp-area="Admin" asp-controller="Product" asp-action="Index"
       class="btn btn-sm btn-outline-secondary">
        <i class="fa fa-arrow-left me-1"></i> Quay lại
    </a>
    <h4 class="mb-0 fw-bold">Sửa sản phẩm</h4>
</div>

<form asp-area="Admin" asp-controller="Product" asp-action="Edit" asp-route-id="@Model.Id" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="row g-4">

        <!-- ═══════════════════════════════════════════════════════════════
             LEFT COLUMN — Main product info + Attributes
        ════════════════════════════════════════════════════════════════ -->
        <div class="col-lg-8">

            <!-- Basic info ──────────────────────────────────────────────── -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h6 class="mb-0 fw-bold">
                        <i class="fa fa-info-circle me-2 text-primary"></i> Thông tin cơ bản
                    </h6>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Slug" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text text-muted" style="font-size:12px;">/san-pham/</span>
                            <input asp-for="Slug" class="form-control" />
                        </div>
                        <span asp-validation-for="Slug" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <!-- Price & Stock ───────────────────────────────────────────── -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h6 class="mb-0 fw-bold">
                        <i class="fa fa-dollar me-2 text-success"></i> Giá & Kho hàng
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="BasePrice" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="BasePrice" class="form-control" type="number" min="0" step="1000" />
                                <span class="input-group-text">₫</span>
                            </div>
                            <span asp-validation-for="BasePrice" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="SalePrice" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="SalePrice" class="form-control" type="number" min="0" step="1000"
                                       placeholder="Để trống nếu không KM" />
                                <span class="input-group-text">₫</span>
                            </div>
                            <span asp-validation-for="SalePrice" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Stock" class="form-label fw-semibold"></label>
                            <input asp-for="Stock" class="form-control" type="number" min="0" />
                            <span asp-validation-for="Stock" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Thumbnail ──────────────────────────────────────────────── -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h6 class="mb-0 fw-bold">
                        <i class="fa fa-image me-2 text-info"></i> Hình ảnh
                    </h6>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="ThumbnailUrl" class="form-label fw-semibold"></label>
                        <input asp-for="ThumbnailUrl" class="form-control"
                               placeholder="https://... hoặc /images/product.jpg"
                               oninput="previewImage(this.value)" />
                        <span asp-validation-for="ThumbnailUrl" class="text-danger small"></span>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.ThumbnailUrl))
                    {
                        <div id="imgPreview" class="mt-2">
                            <img id="previewImg" src="@Model.ThumbnailUrl" alt="Preview"
                                 style="max-height:180px;border-radius:8px;border:1px solid #eee;object-fit:contain;" />
                        </div>
                    }
                    else
                    {
                        <div id="imgPreview" class="mt-2" style="display:none;">
                            <img id="previewImg" src="" alt="Preview"
                                 style="max-height:180px;border-radius:8px;border:1px solid #eee;object-fit:contain;" />
                        </div>
                    }
                </div>
            </div>

            <!-- Attribute card ──────────────────────────────────────────── -->
            @{
                bool hasAttributes = Model.AvailableAttributes.Any();
            }
            <div id="attributeCard" class="card border-0 shadow-sm mb-4"
                 style="@(hasAttributes ? "" : "display:none;")">
                <div class="card-header bg-white border-bottom py-3">
                    <h6 class="mb-0 fw-bold">
                        <i class="fa fa-sliders me-2 text-secondary"></i> Thuộc tính sản phẩm
                    </h6>
                </div>
                <div class="card-body">
                    <div id="attributeSection">

                        @* Server-side render (Edit mode: category already known) *@
                        @if (hasAttributes)
                        {
                            foreach (var attr in Model.AvailableAttributes)
                            {
                                // Find which option in this group is currently selected
                                var selectedOptId = Model.SelectedAttributeValueIds
                                    .FirstOrDefault(id => attr.Options.Any(o => o.Id == id));

                                <div class="mb-3 attr-group" data-attribute-id="@attr.AttributeId">
                                    <label class="form-label fw-semibold">@attr.DisplayName</label>
                                    <select name="SelectedAttributeValueIds" class="form-select">
                                        <option value="">-- Chọn @attr.DisplayName --</option>
                                        @foreach (var opt in attr.Options)
                                        {
                                            <option value="@opt.Id"
                                                    selected="@(opt.Id == selectedOptId ? "selected" : null)">
                                                @opt.DisplayName
                                            </option>
                                        }
                                    </select>
                                </div>
                            }
                        }

                    </div>
                </div>
            </div>

        </div>

        <!-- ═══════════════════════════════════════════════════════════════
             RIGHT COLUMN — Status + Category
        ════════════════════════════════════════════════════════════════ -->
        <div class="col-lg-4">

            <!-- Status ──────────────────────────────────────────────────── -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h6 class="mb-0 fw-bold">
                        <i class="fa fa-toggle-on me-2 text-warning"></i> Trạng thái
                    </h6>
                </div>
                <div class="card-body">
                    <div class="form-check form-switch mb-3">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" />
                        <label asp-for="IsActive" class="form-check-label">Đang bán (hiển thị trên shop)</label>
                    </div>
                    <div class="form-check form-switch">
                        <input asp-for="IsFeatured" class="form-check-input" type="checkbox" role="switch" />
                        <label asp-for="IsFeatured" class="form-check-label">Sản phẩm nổi bật</label>
                    </div>
                </div>
            </div>

            <!-- Category (single dropdown) ─────────────────────────────── -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom py-3">
                    <h6 class="mb-0 fw-bold">
                        <i class="fa fa-tags me-2 text-primary"></i> Danh mục
                    </h6>
                </div>
                <div class="card-body">
                    <label asp-for="CategoryId" class="form-label fw-semibold visually-hidden"></label>
                    <select asp-for="CategoryId" class="form-select" id="categoryDropdown"
                            onchange="onCategoryChange(this.value)">
                        <option value="">-- Chọn danh mục --</option>
                        @foreach (var cat in Model.AllCategories)
                        {
                            <option value="@cat.Id"
                                    selected="@(Model.CategoryId == cat.Id ? "selected" : null)">
                                @cat.Name
                            </option>
                        }
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    <p class="text-muted small mt-2 mb-0">
                        <i class="fa fa-info-circle me-1"></i>
                        Đổi danh mục sẽ cập nhật lại danh sách thuộc tính.
                    </p>
                </div>
            </div>

            <!-- Save buttons ─────────────────────────────────────────────── -->
            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="fa fa-save me-2"></i> Lưu thay đổi
                </button>
                <a asp-area="Admin" asp-controller="Product" asp-action="Index"
                   class="btn btn-outline-secondary">
                    Huỷ
                </a>
            </div>

        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Currently selected attribute value IDs (from server)
        const _existingSelectedIds = @Html.Raw(selectedIdsJson);

        // ── Image preview ─────────────────────────────────────────────────────
        function previewImage(url) {
            const preview = document.getElementById('imgPreview');
            const img     = document.getElementById('previewImg');
            if (url) { img.src = url; preview.style.display = 'block'; }
            else     { preview.style.display = 'none'; }
        }

        // ── Category change → AJAX reload attributes ──────────────────────────
        async function onCategoryChange(categoryId) {
            const card    = document.getElementById('attributeCard');
            const section = document.getElementById('attributeSection');

            if (!categoryId) {
                card.style.display = 'none';
                section.innerHTML  = '';
                return;
            }

            try {
                const resp  = await fetch(`/Admin/Product/GetAttributesByCategory?categoryId=${categoryId}`);
                const attrs = await resp.json();
                renderAttributes(section, attrs, _existingSelectedIds);
                card.style.display = attrs.length > 0 ? 'block' : 'none';
            } catch (e) {
                console.error('Failed to load attributes', e);
            }
        }

        // ── Render attribute dropdowns ────────────────────────────────────────
        function renderAttributes(container, attrs, selectedIds) {
            if (!attrs || attrs.length === 0) {
                container.innerHTML = '<p class="text-muted small mb-0">Danh mục này không có thuộc tính.</p>';
                return;
            }

            let html = '';
            attrs.forEach(attr => {
                // Find which option in this group is in selectedIds
                const selectedId = selectedIds.find(id =>
                    attr.options.some(o => o.id === id)
                ) || 0;

                let optHtml = `<option value="">-- Chọn ${escHtml(attr.displayName)} --</option>`;
                attr.options.forEach(opt => {
                    const sel = opt.id === selectedId ? ' selected' : '';
                    optHtml += `<option value="${opt.id}"${sel}>${escHtml(opt.displayName)}</option>`;
                });

                html += `
                <div class="mb-3 attr-group" data-attribute-id="${attr.attributeId}">
                    <label class="form-label fw-semibold">${escHtml(attr.displayName)}</label>
                    <select name="SelectedAttributeValueIds" class="form-select">
                        ${optHtml}
                    </select>
                </div>`;
            });

            container.innerHTML = html;
        }

        function escHtml(str) {
            const d = document.createElement('div');
            d.appendChild(document.createTextNode(str));
            return d.innerHTML;
        }
    </script>
}
