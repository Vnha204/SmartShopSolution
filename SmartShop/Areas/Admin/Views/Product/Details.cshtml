@model SmartShop.Models.Product
@{
    ViewData["Title"] = "Chi tiết sản phẩm";
    Layout = "_AdminLayout";
}

<div class="d-flex align-items-center mb-4 gap-3">
    <a asp-area="Admin" asp-controller="Product" asp-action="Index"
       class="btn btn-sm btn-outline-secondary">
        <i class="fa fa-arrow-left me-1"></i> Quay lại
    </a>
    <h4 class="mb-0 fw-bold">Chi tiết sản phẩm</h4>
    <div class="ms-auto d-flex gap-2">
        <a asp-area="Admin" asp-controller="Product" asp-action="Edit" asp-route-id="@Model.Id"
           class="btn btn-sm btn-primary">
            <i class="fa fa-pencil me-1"></i> Sửa
        </a>
        <a asp-area="Admin" asp-controller="Product" asp-action="Delete" asp-route-id="@Model.Id"
           class="btn btn-sm btn-outline-danger">
            <i class="fa fa-trash me-1"></i> Xoá
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="mb-0 fw-bold"><i class="fa fa-info-circle me-2 text-primary"></i> Thông tin sản phẩm</h6>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3 text-muted">ID</dt>
                    <dd class="col-sm-9">@Model.Id</dd>

                    <dt class="col-sm-3 text-muted">Tên</dt>
                    <dd class="col-sm-9 fw-semibold">@Model.Name</dd>

                    <dt class="col-sm-3 text-muted">Slug</dt>
                    <dd class="col-sm-9"><code>@Model.Slug</code></dd>

                    <dt class="col-sm-3 text-muted">Mô tả</dt>
                    <dd class="col-sm-9">
                        @if (!string.IsNullOrEmpty(Model.Description))
                        {
                            <span>@Model.Description</span>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </dd>

                    <dt class="col-sm-3 text-muted">Giá gốc</dt>
                    <dd class="col-sm-9 fw-semibold">@Model.BasePrice.ToString("N0") ₫</dd>

                    <dt class="col-sm-3 text-muted">Giá KM</dt>
                    <dd class="col-sm-9">
                        @if (Model.SalePrice.HasValue)
                        {
                            <span class="text-success fw-semibold">@Model.SalePrice.Value.ToString("N0") ₫</span>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </dd>

                    <dt class="col-sm-3 text-muted">Tồn kho</dt>
                    <dd class="col-sm-9">
                        <span class="badge @(Model.Stock > 0 ? "bg-success" : "bg-danger")">@Model.Stock</span>
                    </dd>

                    <dt class="col-sm-3 text-muted">Trạng thái</dt>
                    <dd class="col-sm-9">
                        <span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary")">
                            @(Model.IsActive ? "Đang bán" : "Ngừng bán")
                        </span>
                    </dd>

                    <dt class="col-sm-3 text-muted">Nổi bật</dt>
                    <dd class="col-sm-9">
                        @if (Model.IsFeatured)
                        {
                            <span class="badge" style="background:#f0a500;"><i class="fa fa-star me-1"></i>Nổi bật</span>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </dd>

                    <dt class="col-sm-3 text-muted">Ngày tạo</dt>
                    <dd class="col-sm-9 text-muted small">@Model.CreatedAt.ToString("HH:mm, dd/MM/yyyy")</dd>

                    <dt class="col-sm-3 text-muted">Cập nhật</dt>
                    <dd class="col-sm-9 text-muted small">@Model.UpdatedAt.ToString("HH:mm, dd/MM/yyyy")</dd>
                </dl>
            </div>
        </div>

        <!-- danh mục -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="mb-0 fw-bold"><i class="fa fa-tags me-2 text-primary"></i> Danh mục</h6>
            </div>
            <div class="card-body">
                @if (!Model.ProductCategories.Any())
                {
                    <span class="text-muted small">Chưa gán danh mục</span>
                }
                else
                {
                    @foreach (var pc in Model.ProductCategories)
                    {
                        <span class="badge bg-light text-dark border me-1 mb-1" style="font-size:13px;">
                            @pc.Category?.Name
                        </span>
                    }
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="mb-0 fw-bold"><i class="fa fa-image me-2 text-info"></i> Hình ảnh</h6>
            </div>
            <div class="card-body text-center">
                @if (!string.IsNullOrEmpty(Model.ThumbnailUrl))
                {
                    <img src="@Model.ThumbnailUrl" alt="@Model.Name"
                         style="max-width:100%;max-height:280px;object-fit:contain;border-radius:8px;" />
                }
                else
                {
                    <div class="py-5 text-muted">
                        <i class="fa fa-image fa-3x d-block mb-2" style="opacity:0.3;"></i>
                        Chưa có ảnh
                    </div>
                }
            </div>
        </div>
    </div>
</div>
