@model SmartShop.Models.Order
@{
    ViewData["Title"] = "Chi tiết đơn hàng #" + Model.OrderCode;
}

<!-- Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <a asp-area="Admin" asp-controller="Order" asp-action="Index"
           class="btn btn-sm btn-outline-secondary me-2">
            <i class="fa fa-arrow-left me-1"></i> Quay lại
        </a>
        <span class="fw-bold fs-5">Đơn #@Model.OrderCode</span>
        <span class="badge ms-2 badge-status @GetStatusBadge(Model.Status)">
            @SmartShop.Models.OrderStatus.DisplayNames.GetValueOrDefault(Model.Status, Model.Status)
        </span>
    </div>
    <div class="d-flex gap-2">
        <!-- Quick update form -->
        <div class="dropdown">
            <button class="btn btn-sm btn-outline-primary dropdown-toggle" data-bs-toggle="dropdown">
                <i class="fa fa-refresh me-1"></i> Cập nhật trạng thái
            </button>
            <ul class="dropdown-menu shadow-sm" style="font-size:13px;">
                @foreach (var s in SmartShop.Models.OrderStatus.DisplayNames)
                {
                    <li>
                        <form asp-area="Admin" asp-controller="Order"
                              asp-action="UpdateStatus" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <input type="hidden" name="status" value="@s.Key" />
                            <button type="submit"
                                    class="dropdown-item @(Model.Status == s.Key ? "active" : "")">
                                @s.Value
                            </button>
                        </form>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>

<div class="row g-4">

    <!-- Left col: Order items -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="mb-0 fw-bold"><i class="fa fa-list me-2 text-primary"></i> Sản phẩm đặt hàng</h6>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Sản phẩm</th>
                                <th class="text-center">SL</th>
                                <th class="text-end">Đơn giá</th>
                                <th class="text-end">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.OrderItems)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            @if (item.Product?.ThumbnailUrl != null)
                                            {
                                                <img src="@item.Product.ThumbnailUrl"
                                                     style="width:48px;height:48px;object-fit:contain;border-radius:6px;border:1px solid #eee;" />
                                            }
                                            else
                                            {
                                                <div style="width:48px;height:48px;background:#f5f5f5;border-radius:6px;display:flex;align-items:center;justify-content:center;">
                                                    <i class="fa fa-image text-muted"></i>
                                                </div>
                                            }
                                            <div>
                                                <div class="fw-semibold small">@item.ProductName</div>
                                                <div class="text-muted" style="font-size:11px;">ID: @item.ProductId</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-center">@item.Quantity</td>
                                    <td class="text-end">@item.UnitPrice.ToString("N0") ₫</td>
                                    <td class="text-end fw-semibold">
                                        @((item.UnitPrice * item.Quantity).ToString("N0")) ₫
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <td colspan="3" class="text-end fw-bold">Tổng cộng:</td>
                                <td class="text-end fw-bold text-success fs-6">
                                    @Model.TotalPrice.ToString("N0") ₫
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        <!-- Note -->
        @if (!string.IsNullOrEmpty(Model.Note))
        {
            <div class="card border-0 shadow-sm mt-3">
                <div class="card-body">
                    <h6 class="fw-bold mb-2"><i class="fa fa-sticky-note me-2 text-warning"></i> Ghi chú</h6>
                    <p class="mb-0 text-muted">@Model.Note</p>
                </div>
            </div>
        }
    </div>

    <!-- Right col: Info -->
    <div class="col-lg-4">

        <!-- Order info -->
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="mb-0 fw-bold"><i class="fa fa-info-circle me-2 text-primary"></i> Thông tin đơn hàng</h6>
            </div>
            <div class="card-body">
                <dl class="row small mb-0">
                    <dt class="col-6 text-muted">Mã đơn:</dt>
                    <dd class="col-6 fw-semibold">#@Model.OrderCode</dd>

                    <dt class="col-6 text-muted">Ngày đặt:</dt>
                    <dd class="col-6">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd>

                    <dt class="col-6 text-muted">Cập nhật:</dt>
                    <dd class="col-6">@Model.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</dd>

                    <dt class="col-6 text-muted">Trạng thái:</dt>
                    <dd class="col-6">
                        <span class="badge badge-status @GetStatusBadge(Model.Status)">
                            @SmartShop.Models.OrderStatus.DisplayNames.GetValueOrDefault(Model.Status, Model.Status)
                        </span>
                    </dd>

                    <dt class="col-6 text-muted">Thanh toán:</dt>
                    <dd class="col-6">
                        @Model.PaymentMethod.ToUpper()
                        <br />
                        <span class="badge @(Model.PaymentStatus == "paid" ? "bg-success" : "bg-warning text-dark") badge-status">
                            @(Model.PaymentStatus == "paid" ? "Đã TT" : "Chưa TT")
                        </span>
                    </dd>
                </dl>
            </div>
        </div>

        <!-- Customer info -->
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="mb-0 fw-bold"><i class="fa fa-user me-2 text-primary"></i> Khách hàng</h6>
            </div>
            <div class="card-body small">
                <p class="mb-1 fw-semibold">@(Model.User?.FullName ?? "—")</p>
                <p class="mb-1 text-muted"><i class="fa fa-envelope me-1"></i> @(Model.User?.Email ?? "—")</p>
                <p class="mb-0 text-muted"><i class="fa fa-phone me-1"></i> @(Model.User?.PhoneNumber ?? "Chưa có")</p>
            </div>
        </div>

        <!-- Shipping address -->
        @if (Model.Address != null)
        {
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom py-3">
                    <h6 class="mb-0 fw-bold"><i class="fa fa-map-marker me-2 text-primary"></i> Địa chỉ giao hàng</h6>
                </div>
                <div class="card-body small">
                    <p class="mb-1 fw-semibold">@Model.Address.FullName</p>
                    <p class="mb-1 text-muted"><i class="fa fa-phone me-1"></i> @Model.Address.PhoneNumber</p>
                    <p class="mb-0 text-muted">
                        <i class="fa fa-map-marker me-1"></i>
                        @Model.Address.StreetLine, @Model.Address.Ward,
                        @Model.Address.District, @Model.Address.Province
                    </p>
                </div>
            </div>
        }
    </div>

</div>

@functions {
    string GetStatusBadge(string status) => status switch
    {
        "pending" => "bg-warning text-dark",
        "confirmed" => "bg-info text-dark",
        "processing" => "bg-primary",
        "shipping" => "bg-info",
        "delivered" => "bg-success",
        "cancelled" => "bg-danger",
        _ => "bg-secondary"
    };
}