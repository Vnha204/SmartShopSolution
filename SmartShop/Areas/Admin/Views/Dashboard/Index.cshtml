@{
    ViewData["Title"] = "Tổng quan";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0">Tổng quan <small class="text-muted fs-6">Dashboard</small></h4>
</div>

<div class="row g-3">
    <!-- Sản phẩm -->
    <div class="col-xl-3 col-md-6">
        <div class="card text-white h-100 stat-card" style="background:#f0a500;">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="fw-bold">@ViewBag.TotalProducts</h2>
                    <p class="mb-0">Sản phẩm</p>
                </div>
                <i class="fa fa-shopping-bag fa-3x opacity-50"></i>
            </div>
            <div class="card-footer bg-transparent border-0">
                <a asp-action="Index" asp-controller="Product"
                   class="text-white text-decoration-none small">
                    <i class="fa fa-arrow-right me-1"></i> Chi tiết
                </a>
            </div>
        </div>
    </div>

    <!-- Danh mục -->
    <div class="col-xl-3 col-md-6">
        <div class="card text-white h-100 stat-card" style="background:#28a745;">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="fw-bold">@ViewBag.TotalCategories</h2>
                    <p class="mb-0">Danh mục</p>
                </div>
                <i class="fa fa-tags fa-3x opacity-50"></i>
            </div>
            <div class="card-footer bg-transparent border-0">
                <a asp-action="Index" asp-controller="Category"
                   class="text-white text-decoration-none small">
                    <i class="fa fa-arrow-right me-1"></i> Chi tiết
                </a>
            </div>
        </div>
    </div>

    <!-- Đơn hàng -->
    <div class="col-xl-3 col-md-6">
        <div class="card text-white h-100 stat-card" style="background:#17a2b8;">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="fw-bold">@ViewBag.PendingOrders</h2>
                    <p class="mb-0">Đơn chờ xử lý</p>
                    <small class="opacity-75">@ViewBag.TotalOrders tổng đơn</small>
                </div>
                <i class="fa fa-shopping-cart fa-3x opacity-50"></i>
            </div>
            <div class="card-footer bg-transparent border-0">
                <a asp-action="Index" asp-controller="Order"
                   class="text-white text-decoration-none small">
                    <i class="fa fa-arrow-right me-1"></i> Chi tiết
                </a>
            </div>
        </div>
    </div>

    <!-- Thành viên -->
    <div class="col-xl-3 col-md-6">
        <div class="card text-white h-100 stat-card" style="background:#e91e63;">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="fw-bold">@ViewBag.TotalUsers</h2>
                    <p class="mb-0">Thành viên</p>
                </div>
                <i class="fa fa-users fa-3x opacity-50"></i>
            </div>
            <div class="card-footer bg-transparent border-0">
                <a asp-action="Index" asp-controller="Member"
                   class="text-white text-decoration-none small">
                    <i class="fa fa-arrow-right me-1"></i> Quản lý thành viên
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Recent Orders Section -->
<div class="row mt-4">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold">
                    <i class="fa fa-shopping-cart me-2 text-primary"></i> Đơn hàng gần đây
                </h6>
                <a asp-action="Index" asp-controller="Order" class="btn btn-sm btn-outline-primary">
                    Xem tất cả
                </a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Mã đơn</th>
                                <th>Khách hàng</th>
                                <th>Tổng tiền</th>
                                <th>Trạng thái</th>
                                <th>Ngày tạo</th>
                            </tr>
                        </thead>
                        <tbody id="recent-orders">
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">
                                    <i class="fa fa-spinner fa-spin"></i> Đang tải...
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Members -->
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold">
                    <i class="fa fa-users me-2 text-success"></i> Thành viên mới
                </h6>
                <a asp-action="Index" asp-controller="Member" class="btn btn-sm btn-outline-success">
                    Xem tất cả
                </a>
            </div>
            <div class="card-body p-0">
                <ul class="list-group list-group-flush" id="recent-members">
                    <li class="list-group-item text-center text-muted py-4">
                        <i class="fa fa-spinner fa-spin"></i> Đang tải...
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>