@model VietQRViewModel
@{
    ViewData["Title"] = "Thanh toán VietQR — Đơn #" + Model.Order.OrderCode;
    ViewData["BodyClass"] = "position_head";
    Layout = "~/Views/Shared/_Layout.cshtml";

    bool isPaid = string.Equals(Model.Order.PaymentStatus, "paid", StringComparison.OrdinalIgnoreCase);
}

<section class="vietqr-section">
    <div class="container">

        <h1 class="vietqr-title">Thanh toán VietQR</h1>
        <p class="vietqr-subtitle">Đơn hàng <strong>#@Model.Order.OrderCode</strong></p>

        @if (isPaid)
        {
            <div class="vietqr-status-banner vietqr-status-paid">
                <i class="fa fa-check-circle"></i>
                Đơn hàng đã được xác nhận thanh toán. Cảm ơn bạn!
            </div>
        }
        else
        {
            <div class="vietqr-status-banner vietqr-status-pending">
                <i class="fa fa-clock-o"></i>
                Đơn hàng đang chờ xác nhận thanh toán. Vui lòng chuyển khoản theo thông tin bên dưới.
            </div>
        }

        <div class="row g-4">

            <!-- Left: bank info + instructions -->
            <div class="col-lg-7">

                <!-- Bank account info -->
                <div class="vietqr-card">
                    <div class="vietqr-card-title">
                        <i class="fa fa-bank"></i> Thông tin tài khoản nhận tiền
                    </div>
                    <table class="bank-info-table">
                        <tr>
                            <td>Ngân hàng</td>
                            <td>@Model.BankName</td>
                        </tr>
                        <tr>
                            <td>Số tài khoản</td>
                            <td>@Model.AccountNumber</td>
                        </tr>
                        <tr>
                            <td>Chủ tài khoản</td>
                            <td>@Model.AccountName</td>
                        </tr>
                        <tr>
                            <td>Số tiền</td>
                            <td class="text-primary fw-bold" style="font-size:1.05rem;">
                                @Model.Order.TotalPrice.ToString("N0")₫
                            </td>
                        </tr>
                    </table>

                    <div class="mt-3">
                        <span class="text-muted small">Nội dung chuyển khoản (bắt buộc)</span>
                        <div class="transfer-content-box">
                            <span class="transfer-content-code" id="transferContent">@Model.TransferContent</span>
                            <button class="btn-copy" id="btnCopyContent" type="button">Sao chép</button>
                        </div>
                        <p class="text-danger small mt-1 mb-0">
                            <i class="fa fa-exclamation-circle me-1"></i>
                            Nhập <strong>chính xác</strong> nội dung trên để đơn hàng được xác nhận tự động.
                        </p>
                    </div>
                </div>

                <!-- Steps -->
                <div class="vietqr-card">
                    <div class="vietqr-card-title">
                        <i class="fa fa-list-ol"></i> Hướng dẫn thanh toán
                    </div>
                    <ol class="vietqr-steps">
                        <li>
                            <span class="step-num">1</span>
                            Mở ứng dụng ngân hàng hoặc ví điện tử trên điện thoại.
                        </li>
                        <li>
                            <span class="step-num">2</span>
                            Quét mã QR hoặc nhập thủ công số tài khoản và thông tin.
                        </li>
                        <li>
                            <span class="step-num">3</span>
                            Nhập số tiền <strong>@Model.Order.TotalPrice.ToString("N0")₫</strong> và nội dung <strong>@Model.TransferContent</strong>.
                        </li>
                        <li>
                            <span class="step-num">4</span>
                            Xác nhận giao dịch. Đơn hàng sẽ được xử lý sau khi admin xác nhận thanh toán.
                        </li>
                    </ol>
                </div>

                <div class="vietqr-actions">
                    <a asp-area="Customers" asp-controller="Orders" asp-action="Details"
                       asp-route-orderId="@Model.Order.Id"
                       class="btn-vietqr-orders">
                        <i class="fa fa-eye"></i> Xem đơn hàng
                    </a>
                    <a asp-area="Customers" asp-controller="Orders" asp-action="Index"
                       class="btn-vietqr-orders">
                        <i class="fa fa-list"></i> Tất cả đơn hàng
                    </a>
                </div>

            </div>

            <!-- Right: QR code -->
            <div class="col-lg-5">
                <div class="vietqr-qr-panel">
                    <div class="vietqr-qr-panel-title">
                        <i class="fa fa-qrcode me-1"></i> Mã QR thanh toán
                    </div>

                    @if (!isPaid)
                    {
                        <img src="@Url.Action("VietQRImage", "Payments", new { area = "Customers", orderId = Model.Order.Id })"
                             class="vietqr-qr-img"
                             alt="VietQR code for ORDER_@Model.Order.OrderCode" />
                    }
                    else
                    {
                        <div style="padding:2rem 0; color:var(--success-color);">
                            <i class="fa fa-check-circle fa-4x d-block mb-2"></i>
                            <span class="fw-semibold">Đã thanh toán</span>
                        </div>
                    }

                    <div class="vietqr-amount">@Model.Order.TotalPrice.ToString("N0")₫</div>
                    <div class="vietqr-amount-label">Số tiền cần chuyển</div>

                    <div class="small text-muted">
                        <i class="fa fa-info-circle me-1"></i>
                        Mã QR chứa thông tin thanh toán của đơn hàng này.
                        Quét bằng app ngân hàng hỗ trợ VietQR.
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/customers/vietqr.js" asp-append-version="true"></script>
}
