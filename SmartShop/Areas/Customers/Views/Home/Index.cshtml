<!-- contact section -->
<div id="contact" class="contact">
    <!-- Bọc cả form và map trong 1 div position: relative -->
    <div class="map_section">
        <!-- Map nằm dưới làm nền -->
        <div id="map"></div>

        <!-- Form overlay lên trên map nhờ position: absolute trong CSS -->
        <form id="request" class="main_form">
            <div class="row">
                <div class="col-md-12">
                    <h3>Contact Us</h3>
                </div>
                <div class="col-md-12">
                    <input class="contactus" placeholder="Name" type="text" name="Name" />
                </div>
                <div class="col-md-12">
                    <input class="contactus" placeholder="Phone Number" type="tel" name="PhoneNumber" />
                </div>
                <div class="col-md-12">
                    <input class="contactus" placeholder="Email" type="email" name="Email" />
                </div>
                <div class="col-md-12">
                    <input class="contactusmess" placeholder="Message" type="text" name="Message" />
                </div>
                <div class="col-md-12">
                    <button class="send_btn" type="submit">Send</button>
                </div>
            </div>
        </form>
    </div>
</div>
<!-- end contact section -->