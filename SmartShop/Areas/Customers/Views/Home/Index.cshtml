<!-- end Our Glasses section -->
<!-- Our shop section -->
<div id="about" class="shop">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-5">
                <div class="shop_img">
                    <figure><img src="~/images/shop_img.png" alt="#" /></figure>
                </div>
            </div>
            <div class="col-md-7 padding_right0">
                <div class="max_width">
                    <div class="titlepage">
                        <h2>Kính mắt tốt nhất tại cửa hàng</h2>
                        <p>
                            Chúng tôi cung cấp đa dạng các mẫu kính mắt với chất lượng vượt trội và giá cả
                            hợp lý. Từ kính mát chống tia UV đến kính thuốc thiết kế riêng — SmartShop là
                            điểm đến lý tưởng cho mọi nhu cầu về mắt kính của bạn.
                        </p>
                        <a class="read_more" asp-area="Customers" asp-controller="Shop" asp-action="Index">Mua sắm ngay</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- end Our shop section -->
<!-- clients section -->
<div class="clients">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="titlepage">
                    <h2>Khách hàng nói gì về chúng tôi</h2>
                    <p>
                        Hàng nghìn khách hàng đã tin tưởng chọn SmartShop. Đây là những chia sẻ
                        chân thực từ họ.
                    </p>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                <div id="myCarousel" class="carousel slide clients_Carousel" data-ride="carousel">
                    <ol class="carousel-indicators">
                        <li data-target="#myCarousel" data-slide-to="0" class="active"></li>
                        <li data-target="#myCarousel" data-slide-to="1"></li>
                        <li data-target="#myCarousel" data-slide-to="2"></li>
                    </ol>
                    <div class="carousel-inner">
                        <div class="carousel-item active">
                            <div class="container">
                                <div class="carousel-caption">
                                    <div class="row">
                                        <div class="col-md-12">
                                            <div class="clients_box">
                                                <figure><img src="~/images/our.png" alt="#" /></figure>
                                                <h3>Sandy Mark</h3>
                                                <p>
                                                    Tôi rất hài lòng với chiếc kính mát mua tại SmartShop.
                                                    Chất lượng tuyệt vời, gọng kính chắc chắn và tròng kính
                                                    chống tia UV hiệu quả. Dịch vụ tư vấn nhiệt tình, giao
                                                    hàng nhanh chóng. Sẽ ủng hộ tiếp!
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="carousel-item">
                            <div class="container">
                                <div class="carousel-caption">
                                    <div class="row">
                                        <div class="col-md-12">
                                            <div class="clients_box">
                                                <figure><img src="~/images/our.png" alt="#" /></figure>
                                                <h3>John Doe</h3>
                                                <p>
                                                    Kính mát chất lượng cao với mức giá rất hợp lý. Tôi
                                                    không thể hài lòng hơn với món hàng này. Tròng kính
                                                    trong suốt, gọng kính rất bền.
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="carousel-item">
                            <div class="container">
                                <div class="carousel-caption">
                                    <div class="row">
                                        <div class="col-md-12">
                                            <div class="clients_box">
                                                <figure><img src="~/images/our.png" alt="#" /></figure>
                                                <h3>Emily Rose</h3>
                                                <p>
                                                    Tôi yêu thích sự đa dạng về mẫu mã ở đây. Nhân viên
                                                    tư vấn rất nhiệt tình và giao hàng cực kỳ nhanh. Chắc
                                                    chắn sẽ quay lại mua tiếp!
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <a class="carousel-control-prev" href="#myCarousel" role="button" data-slide="prev">
                        <i class="fa fa-angle-left"></i>
                    </a>
                    <a class="carousel-control-next" href="#myCarousel" role="button" data-slide="next">
                        <i class="fa fa-angle-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- end clients section -->
<!-- contact section -->
<div id="contact" class="contact">
    <!-- Bọc cả form và map trong 1 div position: relative -->
    <div class="map_section">
        <!-- Map nằm dưới làm nền -->
        <div id="map"></div>

        <!-- Form overlay lên trên map nhờ position: absolute trong CSS -->
        <form id="request" class="main_form">
            <div class="row">
                <div class="col-md-12">
                    <h3>Liên hệ với chúng tôi</h3>
                </div>
                <div class="col-md-12">
                    <input class="contactus" placeholder="Họ tên" type="text" name="Name" />
                </div>
                <div class="col-md-12">
                    <input class="contactus" placeholder="Số điện thoại" type="tel" name="PhoneNumber" />
                </div>
                <div class="col-md-12">
                    <input class="contactus" placeholder="Email" type="email" name="Email" />
                </div>
                <div class="col-md-12">
                    <input class="contactusmess" placeholder="Tin nhắn" type="text" name="Message" />
                </div>
                <div class="col-md-12">
                    <button class="send_btn" type="submit">Gửi</button>
                </div>
            </div>
        </form>
    </div>
</div>
<!-- end contact section -->