@{
    ViewData["Title"] = "Trang chủ";
    ViewData["ActivePage"] = "Home";
    ViewData["ShowMap"] = true;
}

<!-- banner -->
<section class="banner_main">
    <div id="banner1" class="carousel slide" data-bs-ride="carousel" data-bs-interval="4000">
        <ol class="carousel-indicators">
            <li data-bs-target="#banner1" data-bs-slide-to="0" class="active"></li>
            <li data-bs-target="#banner1" data-bs-slide-to="1"></li>
            <li data-bs-target="#banner1" data-bs-slide-to="2"></li>
        </ol>
        <div class="carousel-inner">
            <div class="carousel-item active">
                <div class="container">
                    <div class="carousel-caption">
                        <div class="text-bg">
                            <h1><span class="blu">Chào mừng <br /></span>đến SmartShop</h1>
                            <figure><img src="~/images/banner_img.png" alt="#" /></figure>
                            <a class="read_more" asp-area="Customers" asp-controller="Shop" asp-action="Index">Mua sắm ngay</a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="carousel-item">
                <div class="container">
                    <div class="carousel-caption">
                        <div class="text-bg">
                            <h1><span class="blu">Khám phá <br /></span>mắt kính cao cấp</h1>
                            <figure><img src="~/images/banner_img.png" alt="#" /></figure>
                            <a class="read_more" asp-area="Customers" asp-controller="Shop" asp-action="Index">Mua sắm ngay</a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="carousel-item">
                <div class="container">
                    <div class="carousel-caption">
                        <div class="text-bg">
                            <h1><span class="blu">Phong cách &amp; <br /></span>Bảo vệ mắt</h1>
                            <figure><img src="~/images/banner_img.png" alt="#" /></figure>
                            <a class="read_more" asp-area="Customers" asp-controller="Shop" asp-action="Index">Mua sắm ngay</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- thuộc tính bootstrap 5 -->
        <button class="carousel-control-prev" type="button" data-bs-target="#banner1" data-bs-slide="prev">
            <i class="fa fa-arrow-left" aria-hidden="true"></i>
            <span class="visually-hidden">Trước</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#banner1" data-bs-slide="next">
            <i class="fa fa-arrow-right" aria-hidden="true"></i>
            <span class="visually-hidden">Sau</span>
        </button>
    </div>
</section>
<!-- giới thiệu -->
<div class="about">
    <div class="container">
        <div class="row d_flex">
            <div class="col-md-5">
                <div class="about_img">
                    <figure><img src="~/images/about_img.png" alt="#" /></figure>
                </div>
            </div>
            <div class="col-md-7">
                <div class="titlepage">
                    <h2>Về cửa hàng chúng tôi</h2>
                    <p>
                        SmartShop chuyên cung cấp các sản phẩm kính mắt cao cấp — từ kính mát thời trang
                        đến kính thuốc chính xác. Chúng tôi cam kết mang đến cho bạn trải nghiệm mua sắm
                        tốt nhất với đội ngũ tư vấn nhiệt tình, sản phẩm đa dạng và chính sách hậu mãi
                        uy tín.
                    </p>
                </div>
                <a class="read_more" asp-area="Customers" asp-controller="About" asp-action="Index">Xem thêm</a>
            </div>
        </div>
    </div>
</div>
<!-- bộ sưu tập kính -->
@{
    var featuredProducts = ViewBag.FeaturedProducts as List<SmartShop.Models.ViewModels.ProductItemVM>
                           ?? new List<SmartShop.Models.ViewModels.ProductItemVM>();
}
<div class="glasses">
    <div class="container">
        <div class="row">
            <div class="col-md-10 offset-md-1">
                <div class="titlepage">
                    <h2>Bộ sưu tập kính</h2>
                    <p>
                        Khám phá các mẫu kính mắt đa dạng — từ kính mát thời thượng đến kính thuốc
                        hiện đại, phù hợp với mọi phong cách và nhu cầu.
                    </p>
                </div>
            </div>
        </div>
    </div>
    <div class="container-fluid glasses-cards-container">
        <div class="row">
            @foreach (var product in featuredProducts)
            {
                <div class="col-xl-3 col-lg-3 col-md-6 col-sm-6">
                    <a class="shop-card-link"
                       asp-area="Customers"
                       asp-controller="Shop"
                       asp-action="Index">
                        <div class="glasses_box shop_item shop-card position-relative">
                            @if (product.IsOnSale)
                            {
                                <span class="sale-badge">-@product.DiscountPercent%</span>
                            }
                            <figure>
                                <img src="@(product.ThumbnailUrl ?? "/images/no-image.png")"
                                     alt="@product.Name" />
                            </figure>
                            <h3>
                                <span class="blu">₫</span>@product.DisplayPrice.ToString("N0")
                                @if (product.IsOnSale)
                                {
                                    <small class="original-price ms-2">₫@product.BasePrice.ToString("N0")</small>
                                }
                            </h3>
                            <p>@product.Name</p>
                        </div>
                    </a>
                </div>
            }
            <div class="col-md-12">
                <a class="read_more" asp-area="Customers" asp-controller="Glasses" asp-action="Index">Xem tất cả</a>
            </div>
        </div>
    </div>
</div>
<!-- khu vực shop -->
<div id="about" class="shop">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-5">
                <div class="shop_img">
                    <figure><img src="~/images/shop_img.png" alt="#" /></figure>
                </div>
            </div>
            <div class="col-md-7 padding_right0">
                <div class="max_width">
                    <div class="titlepage">
                        <h2>Kính mắt tốt nhất tại cửa hàng</h2>
                        <p>
                            Chúng tôi cung cấp đa dạng các mẫu kính mắt với chất lượng vượt trội và giá cả
                            hợp lý. Từ kính mát chống tia UV đến kính thuốc thiết kế riêng — SmartShop là
                            điểm đến lý tưởng cho mọi nhu cầu về mắt kính của bạn.
                        </p>
                        <a class="read_more" asp-area="Customers" asp-controller="Shop" asp-action="Index">Mua sắm ngay</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- đánh giá khách hàng -->
<div class="clients">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="titlepage">
                    <h2>Khách hàng nói gì về chúng tôi</h2>
                    <p>
                        Hàng nghìn khách hàng đã tin tưởng chọn SmartShop. Đây là những chia sẻ
                        chân thực từ họ.
                    </p>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                <div id="myCarousel" class="carousel slide clients_Carousel" data-ride="carousel">
                    <ol class="carousel-indicators">
                        <li data-target="#myCarousel" data-slide-to="0" class="active"></li>
                        <li data-target="#myCarousel" data-slide-to="1"></li>
                        <li data-target="#myCarousel" data-slide-to="2"></li>
                    </ol>
                    <div class="carousel-inner">
                        <div class="carousel-item active">
                            <div class="container">
                                <div class="carousel-caption">
                                    <div class="row">
                                        <div class="col-md-12">
                                            <div class="clients_box">
                                                <figure><img src="~/images/our.png" alt="#" /></figure>
                                                <h3>Sandy Mark</h3>
                                                <p>
                                                    Tôi rất hài lòng với chiếc kính mát mua tại SmartShop.
                                                    Chất lượng tuyệt vời, gọng kính chắc chắn và tròng kính
                                                    chống tia UV hiệu quả. Dịch vụ tư vấn nhiệt tình, giao
                                                    hàng nhanh chóng. Sẽ ủng hộ tiếp!
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="carousel-item">
                            <div class="container">
                                <div class="carousel-caption">
                                    <div class="row">
                                        <div class="col-md-12">
                                            <div class="clients_box">
                                                <figure><img src="~/images/our.png" alt="#" /></figure>
                                                <h3>John Doe</h3>
                                                <p>
                                                    Kính mát chất lượng cao với mức giá rất hợp lý. Tôi
                                                    không thể hài lòng hơn với món hàng này. Tròng kính
                                                    trong suốt, gọng kính rất bền.
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="carousel-item">
                            <div class="container">
                                <div class="carousel-caption">
                                    <div class="row">
                                        <div class="col-md-12">
                                            <div class="clients_box">
                                                <figure><img src="~/images/our.png" alt="#" /></figure>
                                                <h3>Emily Rose</h3>
                                                <p>
                                                    Tôi yêu thích sự đa dạng về mẫu mã ở đây. Nhân viên
                                                    tư vấn rất nhiệt tình và giao hàng cực kỳ nhanh. Chắc
                                                    chắn sẽ quay lại mua tiếp!
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <a class="carousel-control-prev" href="#myCarousel" role="button" data-slide="prev">
                        <i class="fa fa-angle-left"></i>
                    </a>
                    <a class="carousel-control-next" href="#myCarousel" role="button" data-slide="next">
                        <i class="fa fa-angle-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- liên hệ -->
<div id="contact" class="contact">
    <!-- bọc form và map -->
    <div class="map_section">
        <!-- map làm nền -->
        <div id="map"></div>

        <form id="request" class="main_form">
            <div class="row">
                <div class="col-md-12">
                    <h3>Liên hệ với chúng tôi</h3>
                </div>
                <div class="col-md-12">
                    <input class="contactus" placeholder="Họ tên" type="text" name="Name" />
                </div>
                <div class="col-md-12">
                    <input class="contactus" placeholder="Số điện thoại" type="tel" name="PhoneNumber" />
                </div>
                <div class="col-md-12">
                    <input class="contactus" placeholder="Email" type="email" name="Email" />
                </div>
                <div class="col-md-12">
                    <input class="contactusmess" placeholder="Tin nhắn" type="text" name="Message" />
                </div>
                <div class="col-md-12">
                    <button class="send_btn" type="submit">Gửi</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/contact.js" asp-append-version="true"></script>
}