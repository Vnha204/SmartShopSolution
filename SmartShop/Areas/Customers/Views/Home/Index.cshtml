@{
    ViewData["Title"] = "Home";
    ViewData["ActivePage"] = "Home";
    ViewData["ShowMap"] = true;
}

<!-- banner -->
<section class="banner_main">
    <div id="banner1" class="carousel slide" data-bs-ride="carousel" data-bs-interval="4000">
        <ol class="carousel-indicators">
            <li data-bs-target="#banner1" data-bs-slide-to="0" class="active"></li>
            <li data-bs-target="#banner1" data-bs-slide-to="1"></li>
            <li data-bs-target="#banner1" data-bs-slide-to="2"></li>
        </ol>
        <div class="carousel-inner">
            <div class="carousel-item active">
                <div class="container">
                    <div class="carousel-caption">
                        <div class="text-bg">
                            <h1><span class="blu">Welcome <br /></span>To Our Sunglasses</h1>
                            <figure><img src="~/images/banner_img.png" alt="#" /></figure>
                            <a class="read_more" asp-area="Customers" asp-controller="Shop" asp-action="Index">Shop Now</a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="carousel-item">
                <div class="container">
                    <div class="carousel-caption">
                        <div class="text-bg">
                            <h1><span class="blu">Discover <br /></span>Premium Eyewear</h1>
                            <figure><img src="~/images/banner_img.png" alt="#" /></figure>
                            <a class="read_more" asp-area="Customers" asp-controller="Shop" asp-action="Index">Shop Now</a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="carousel-item">
                <div class="container">
                    <div class="carousel-caption">
                        <div class="text-bg">
                            <h1><span class="blu">Style &amp; <br /></span>Protection</h1>
                            <figure><img src="~/images/banner_img.png" alt="#" /></figure>
                            <a class="read_more" asp-area="Customers" asp-controller="Shop" asp-action="Index">Shop Now</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- FIX: Bootstrap 5 data attributes -->
        <button class="carousel-control-prev" type="button" data-bs-target="#banner1" data-bs-slide="prev">
            <i class="fa fa-arrow-left" aria-hidden="true"></i>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#banner1" data-bs-slide="next">
            <i class="fa fa-arrow-right" aria-hidden="true"></i>
            <span class="visually-hidden">Next</span>
        </button>
    </div>
</section>
<!-- end banner -->
<!-- about section -->
<div class="about">
    <div class="container">
        <div class="row d_flex">
            <div class="col-md-5">
                <div class="about_img">
                    <figure><img src="~/images/about_img.png" alt="#" /></figure>
                </div>
            </div>
            <div class="col-md-7">
                <div class="titlepage">
                    <h2>About Our Shop</h2>
                    <p>
                        There are many variations of passages of Lorem Ipsum available, but the majority have
                        suffered alteration in some form, by injected humour, or randomised words which don't
                        look even slightly believable. If you are going to use a passage of Lorem Ipsum, you
                        need to be sure there isn't anything embarrassing hidden in the middle of text.
                    </p>
                </div>
                <a class="read_more" asp-area="Customers" asp-controller="About" asp-action="Index">Read More</a>
            </div>
        </div>
    </div>
</div>
<!-- end about section -->
