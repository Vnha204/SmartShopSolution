@model SmartShop.Models.ViewModels.ShopViewModel
@{ Layout = null; }
<div id="ajaxAttrFilters">
    @if (Model?.Filter?.SelectedCategoryId != null
         && Model.Attributes != null && Model.Attributes.Any())
    {
        @foreach (var attr in Model.Attributes)
        {
            <div class="filter_group">
                <h5><i class="fa fa-list me-2"></i> @attr.DisplayName</h5>
                <ul class="list-unstyled">
                    @foreach (var val in attr.Values)
                    {
                        <li>
                            <label class="d-flex align-items-center justify-content-between">
                                <span>
                                    <input type="checkbox"
                                           name="attributeValueIds"
                                           value="@val.Id"
                                           checked="@(val.IsSelected ? "checked" : null)" />
                                    <span class="ms-2">@val.DisplayName</span>
                                </span>
                                <span class="badge bg-light text-muted ms-2">@val.ProductCount</span>
                            </label>
                        </li>
                    }
                </ul>
            </div>
        }
    }
</div>

<div id="ajaxProductGrid">

    @if (Model?.SelectedCategoryBreadcrumb?.Any() == true)
    {
        <nav aria-label="breadcrumb" class="mb-2">
            <ol class="breadcrumb small mb-0">
                <li class="breadcrumb-item">
                    <a asp-area="Customers" asp-controller="Shop" asp-action="Index">Tất cả</a>
                </li>
                @foreach (var bc in Model.SelectedCategoryBreadcrumb)
                {
                    <li class="breadcrumb-item active">@bc.Name</li>
                }
            </ol>
        </nav>
    }

    <div class="d-flex justify-content-between align-items-center mb-4 p-3 bg-white rounded shadow-sm">
        <span class="text-muted">
            Tìm thấy <strong>@(Model?.TotalProducts ?? 0)</strong> sản phẩm
        </span>
        <div>
            <select class="form-select form-select-sm" style="width: auto;" id="sortBy">
                <option value="newest"     selected="@(Model?.SortBy == "newest"     ? "selected" : null)">Mới nhất</option>
                <option value="price-asc"  selected="@(Model?.SortBy == "price-asc"  ? "selected" : null)">Giá: Thấp → Cao</option>
                <option value="price-desc" selected="@(Model?.SortBy == "price-desc" ? "selected" : null)">Giá: Cao → Thấp</option>
                <option value="popular"    selected="@(Model?.SortBy == "popular"    ? "selected" : null)">Phổ biến nhất</option>
            </select>
        </div>
    </div>

    <div class="row">
        @if (Model?.Products != null && Model.Products.Any())
        {
            @foreach (var product in Model.Products)
            {
                <div class="col-xl-4 col-lg-4 col-md-6 col-sm-6">
                    <a class="shop-card-link"
                       asp-area="Customers"
                       asp-controller="Shop"
                       asp-action="Detail"
                       asp-route-slug="@product.Slug">
                        <div class="glasses_box shop_item shop-card position-relative">
                            @if (product.IsOnSale)
                            {
                                <span class="sale-badge">-@product.DiscountPercent%</span>
                            }
                            <figure>
                                <img src="@(product.ThumbnailUrl ?? "~/images/no-image.png")" alt="@product.Name" />
                            </figure>
                            <h3>
                                <span class="blu">₫</span>@product.DisplayPrice.ToString("N0")
                                @if (product.IsOnSale)
                                {
                                    <small class="original-price ms-2">₫@product.BasePrice.ToString("N0")</small>
                                }
                            </h3>
                            <p>@product.Name</p>
                        </div>
                    </a>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <i class="fa fa-search fa-3x text-muted mb-3"></i>
                <p class="text-muted">Không tìm thấy sản phẩm nào phù hợp.</p>
                <button class="btn btn-outline-primary" id="clearFiltersEmpty">Xóa bộ lọc</button>
            </div>
        }
    </div>
    @if (Model?.TotalPages > 1)
    {
        <nav class="mt-4 shop-pagination">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" data-page="@(Model.CurrentPage - 1)" href="#">Trước</a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" data-page="@i" href="#">@i</a>
                    </li>
                }
                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" data-page="@(Model.CurrentPage + 1)" href="#">Sau</a>
                </li>
            </ul>
        </nav>
    }

</div>
