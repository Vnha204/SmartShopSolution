@model SmartShop.Models.ViewModels.ShopViewModel
@{
    ViewData["Title"] = "Shop";
    ViewData["ActivePage"] = "Shop";
    ViewData["BodyClass"] = "position_head";
}

<!-- shop section -->
<div class="shop_page inner_page">
    <div class="container">
        <div class="row">
            <div class="col-md-10 offset-md-1">
                <div class="titlepage">
                    <h2>Cửa hàng</h2>
                    <p>Khám phá bộ sưu tập kính mắt — lọc theo danh mục, kiểu dáng và giá.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="container" style="margin-top: 30px;">
        <div class="row">
            <!-- Sidebar Filter -->
            <div class="col-lg-3 col-md-4">
                <div class="shop_sidebar">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="mb-0 fw-bold">
                            <i class="fa fa-filter me-2"></i> Bộ lọc
                        </h5>
                        <button type="button" class="btn btn-sm btn-link text-muted p-0" id="clearFilters">
                            Xóa bộ lọc
                        </button>
                    </div>

                    <form id="filterForm" method="get" asp-action="Index">
                        <!-- Category Filter -->
                        <div class="filter_group">
                            <h5><i class="fa fa-tag me-2"></i> Danh mục</h5>
                            <ul class="list-unstyled">
                                @if (Model?.Categories != null && Model.Categories.Any())
                                {
                                    @foreach (var cat in Model.Categories)
                                    {
                                        <li>
                                            <label class="d-flex align-items-center justify-content-between">
                                                <span>
                                                    <input type="checkbox" name="categoryIds" value="@cat.Id"
                                                           @(cat.IsSelected ? "checked" : "") />
                                                    <span class="ms-2">@cat.Name</span>
                                                </span>
                                                <span class="badge bg-light text-muted ms-2">@cat.ProductCount</span>
                                            </label>
                                        </li>
                                    }
                                }
                            </ul>
                        </div>

                        <!-- Price Range Filter -->
                        <div class="filter_group">
                            <h5><i class="fa fa-money me-2"></i> Khoảng giá</h5>
                            <div class="price-inputs d-flex gap-2 mb-3">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text">₫</span>
                                    <input type="number" class="form-control" name="minPrice"
                                           value="@Model?.Filter?.MinPrice" placeholder="Từ" />
                                </div>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text">₫</span>
                                    <input type="number" class="form-control" name="maxPrice"
                                           value="@Model?.Filter?.MaxPrice" placeholder="Đến" />
                                </div>
                            </div>
                            <ul class="list-unstyled price-presets">
                                @if (Model?.PriceRanges != null && Model.PriceRanges.Any())
                                {
                                    @foreach (var range in Model.PriceRanges)
                                    {
                                        <li>
                                            <label>
                                                <input type="radio" name="priceRange" value="@range.Value"
                                                       @(range.IsSelected ? "checked" : "") />
                                                @range.Label
                                                <span class="badge bg-light text-muted">@range.ProductCount</span>
                                            </label>
                                        </li>
                                    }
                                }
                            </ul>
                        </div>

                        <!-- Dynamic Attribute Filters -->
                        @if (Model?.Attributes != null)
                        {
                            @foreach (var attr in Model.Attributes)
                            {
                                <div class="filter_group">
                                    <h5><i class="fa fa-list me-2"></i> @attr.DisplayName</h5>
                                    <ul class="list-unstyled">
                                        @foreach (var val in attr.Values)
                                        {
                                            <li>
                                                <label>
                                                    <input type="checkbox" name="attributeValueIds" value="@val.Id"
                                                           @(val.IsSelected ? "checked" : "") />
                                                    @val.Value
                                                    <span class="badge bg-light text-muted">@val.ProductCount</span>
                                                </label>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                        }

                        <button type="submit" class="btn btn-primary-custom w-100">
                            <i class="fa fa-search me-2"></i> Áp dụng bộ lọc
                        </button>
                    </form>
                </div>
            </div>

            <!-- Product Grid -->
            <div class="col-lg-9 col-md-8">
                <!-- Top filter bar (dropdowns) -->
                <div class="mb-3">
                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        <div class="dropdown">
                            <button class="btn btn-outline-secondary dropdown-toggle" type="button" id="filterCategoryBtn"
                                    data-bs-toggle="dropdown" aria-expanded="false">
                                Danh mục sản phẩm
                            </button>
                            <ul class="dropdown-menu" aria-labelledby="filterCategoryBtn">
                                @foreach (var cat in Model.Categories)
                                {
                                    <li>
                                        <a class="dropdown-item" href="#" data-shop-filter data-target-input="input[name='categoryIds'][value='@cat.Id']">
                                            @cat.Name <span class="text-muted ms-2">(@cat.ProductCount)</span>
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>

                        <div class="dropdown">
                            <button class="btn btn-outline-secondary dropdown-toggle" type="button" id="filterGenderBtn"
                                    data-bs-toggle="dropdown" aria-expanded="false">
                                Giới tính
                            </button>
                            <ul class="dropdown-menu" aria-labelledby="filterGenderBtn">
                                <li><a class="dropdown-item" href="#" data-shop-filter data-target-input="input[name='attributeValueIds'][value='1']">Nam</a></li>
                                <li><a class="dropdown-item" href="#" data-shop-filter data-target-input="input[name='attributeValueIds'][value='2']">Nữ</a></li>
                                <li><a class="dropdown-item" href="#" data-shop-filter data-target-input="input[name='attributeValueIds'][value='3']">Unisex</a></li>
                            </ul>
                        </div>

                        <div class="dropdown">
                            <button class="btn btn-outline-secondary dropdown-toggle" type="button" id="filterStyleBtn"
                                    data-bs-toggle="dropdown" aria-expanded="false">
                                Kiểu dáng
                            </button>
                            <ul class="dropdown-menu" aria-labelledby="filterStyleBtn">
                                @* Example values; they map to attributeValueIds in the filter form *@
                                <li><a class="dropdown-item" href="#" data-shop-filter data-target-input="input[name='attributeValueIds'][value='4']">Tròn</a></li>
                                <li><a class="dropdown-item" href="#" data-shop-filter data-target-input="input[name='attributeValueIds'][value='5']">Vuông</a></li>
                            </ul>
                        </div>

                        <div class="dropdown">
                            <button class="btn btn-outline-secondary dropdown-toggle" type="button" id="filterMaterialBtn"
                                    data-bs-toggle="dropdown" aria-expanded="false">
                                Chất liệu
                            </button>
                            <ul class="dropdown-menu" aria-labelledby="filterMaterialBtn">
                                <li><a class="dropdown-item" href="#" data-shop-filter data-target-input="input[name='attributeValueIds'][value='6']">Kim loại</a></li>
                                <li><a class="dropdown-item" href="#" data-shop-filter data-target-input="input[name='attributeValueIds'][value='7']">Nhựa</a></li>
                            </ul>
                        </div>

                        <div class="dropdown">
                            <button class="btn btn-outline-secondary dropdown-toggle" type="button" id="filterPriceBtn"
                                    data-bs-toggle="dropdown" aria-expanded="false">
                                Khoảng giá
                            </button>
                            <ul class="dropdown-menu" aria-labelledby="filterPriceBtn">
                                @foreach (var r in Model.PriceRanges)
                                {
                                    <li>
                                        <a class="dropdown-item" href="#" data-shop-filter data-target-input="input[name='priceRange'][value='@r.Value']">
                                            @r.Label
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>

                        <div class="ms-auto">
                            <span class="text-muted"><strong id="productCount">@(Model?.TotalProducts ?? 0)</strong> sản phẩm</span>
                        </div>
                    </div>
                </div>

                <!-- Sort & view (kept) -->
                <div class="d-flex justify-content-between align-items-center mb-4 p-3 bg-white rounded shadow-sm">
                    <span class="text-muted">
                        <strong id="productCountTop">@(Model?.TotalProducts ?? 0)</strong> sản phẩm
                    </span>
                    <div class="d-flex gap-3 align-items-center">
                        <select class="form-select form-select-sm" style="width: auto;" name="sortBy" id="sortBy">
                            <option value="newest" selected="@(Model?.SortBy == "newest")">Mới nhất</option>
                            <option value="price-asc" selected="@(Model?.SortBy == "price-asc")">Giá: Thấp → Cao</option>
                            <option value="price-desc" selected="@(Model?.SortBy == "price-desc")">Giá: Cao → Thấp</option>
                            <option value="popular" selected="@(Model?.SortBy == "popular")">Phổ biến nhất</option>
                        </select>
                    </div>
                </div>

                <div class="row" id="productGrid">
                    @if (Model?.Products != null && Model.Products.Any())
                    {
                        @foreach (var product in Model.Products)
                        {
                            <div class="col-xl-4 col-lg-4 col-md-6 col-sm-6">
                                <div class="glasses_box shop_item position-relative">
                                    @if (product.IsOnSale)
                                    {
                                        <span class="sale-badge">-@product.DiscountPercent%</span>
                                    }
                                    <a asp-area="Customers" asp-controller="Shop" asp-action="Detail" asp-route-slug="@product.Slug">
                                        <figure>
                                            <img src="@(product.ThumbnailUrl ?? "~/images/no-image.png")" alt="@product.Name" />
                                        </figure>
                                    </a>
                                    <h3>
                                        <span class="blu">₫</span>@product.DisplayPrice.ToString("N0")
                                        @if (product.IsOnSale)
                                        {
                                            <small class="original-price ms-2">₫@product.BasePrice.ToString("N0")</small>
                                        }
                                    </h3>
                                    <p>@product.Name</p>
                                    <button class="send_btn add_cart" data-product-id="@product.Id">
                                        <i class="fa fa-shopping-cart me-1"></i> Thêm vào giỏ
                                    </button>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="col-12 text-center py-5">
                            <i class="fa fa-search fa-3x text-muted mb-3"></i>
                            <p class="text-muted">Không tìm thấy sản phẩm nào phù hợp.</p>
                            <button class="btn btn-outline-primary" id="clearFiltersEmpty">Xóa bộ lọc</button>
                        </div>
                    }
                </div>

                <!-- Pagination -->
                @if (Model?.TotalPages > 1)
                {
                    <nav class="mt-4">
                        <ul class="pagination justify-content-center">
                            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" asp-route-page="@(Model.CurrentPage - 1)">Trước</a>
                            </li>
                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" asp-route-page="@i">@i</a>
                                </li>
                            }
                            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" asp-route-page="@(Model.CurrentPage + 1)">Sau</a>
                            </li>
                        </ul>
                    </nav>
                }
            </div>
        </div>
    </div>
</div>
<!-- end shop section -->
@section Scripts {
    <script src="~/js/shop.js"></script>
}