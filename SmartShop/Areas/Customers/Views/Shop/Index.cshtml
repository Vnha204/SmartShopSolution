@model SmartShop.Models.ViewModels.ShopViewModel
@{
    ViewData["Title"] = "Shop";
    ViewData["ActivePage"] = "Shop";
    ViewData["BodyClass"] = "position_head";
}
<div class="shop_page inner_page">
    <div class="container">
        <div class="row">
            <div class="col-md-10 offset-md-1">
                <div class="titlepage">
                    <h2>Cửa hàng</h2>
                    <p>Khám phá bộ sưu tập kính mắt — lọc theo danh mục, kiểu dáng và giá.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="container" style="margin-top: 30px;">
        <div class="row">

            <div class="col-lg-3 col-md-4">
                <div class="shop_sidebar">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="mb-0 fw-bold">
                            <i class="fa fa-filter me-2"></i> Bộ lọc
                        </h5>
                        <button type="button" class="btn btn-sm btn-link text-muted p-0" id="clearFilters">
                            Xóa bộ lọc
                        </button>
                    </div>

                    <form id="filterForm" method="get" asp-action="Index">
                        <!-- bộ lọc danh mục -->
                        <div class="filter_group">
                            <h5><i class="fa fa-tag me-2"></i> Danh mục</h5>

                            <input type="hidden"
                                   name="selectedCategoryId"
                                   id="selectedCategoryId"
                                   value="@(Model?.Filter?.SelectedCategoryId?.ToString() ?? "")" />
                            <!-- dropdown danh mục -->
                            <div id="categoryChainContainer"></div>

                            @if (Model?.SelectedCategoryBreadcrumb?.Any() == true)
                            {
                                <div class="mt-2 small text-success fw-semibold" id="serverBreadcrumb">
                                    <i class="fa fa-check-circle me-1"></i>
                                    @string.Join(" › ", Model.SelectedCategoryBreadcrumb.Select(b => b.Name))
                                </div>
                                <button type="button" class="btn btn-sm btn-link text-muted p-0 mt-1" id="clearCategory">
                                    <i class="fa fa-times me-1"></i> Bỏ chọn
                                </button>
                            }

                            <p class="text-muted small mt-2 mb-0">
                                <i class="fa fa-info-circle me-1"></i>
                                Chọn danh mục để lọc sản phẩm và xem thuộc tính phù hợp.
                            </p>
                        </div>

                        <div id="sidebarAttrFilters">
                        @if (Model?.Filter?.SelectedCategoryId != null
                             && Model.Attributes != null && Model.Attributes.Any())
                        {
                            @foreach (var attr in Model.Attributes)
                            {
                                <div class="filter_group">
                                    <h5><i class="fa fa-list me-2"></i> @attr.DisplayName</h5>
                                    <ul class="list-unstyled">
                                        @foreach (var val in attr.Values)
                                        {
                                            <li>
                                                <label class="d-flex align-items-center justify-content-between">
                                                    <span>
                                                        <input type="checkbox"
                                                               name="attributeValueIds"
                                                               value="@val.Id"
                                                               checked="@(val.IsSelected ? "checked" : null)" />
                                                        <span class="ms-2">@val.DisplayName</span>
                                                    </span>
                                                    <span class="badge bg-light text-muted ms-2">@val.ProductCount</span>
                                                </label>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                        }
                        </div>
                        <!-- bộ lọc khoảng giá -->
                        <div class="filter_group">
                            <h5><i class="fa fa-money me-2"></i> Khoảng giá</h5>
                            <div class="price-inputs d-flex gap-2 mb-3">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text">₫</span>
                                    <input type="number" class="form-control" name="minPrice"
                                           value="@Model?.Filter?.MinPrice" placeholder="Từ" />
                                </div>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text">₫</span>
                                    <input type="number" class="form-control" name="maxPrice"
                                           value="@Model?.Filter?.MaxPrice" placeholder="Đến" />
                                </div>
                            </div>
                            <ul class="list-unstyled price-presets">
                                @if (Model?.PriceRanges != null)
                                {
                                    @foreach (var range in Model.PriceRanges)
                                    {
                                        <li>
                                            <label>
                                                <input type="radio" name="priceRange" value="@range.Value"
                                                       checked="@(range.IsSelected ? "checked" : null)" />
                                                @range.Label
                                                <span class="badge bg-light text-muted">@range.ProductCount</span>
                                            </label>
                                        </li>
                                    }
                                }
                            </ul>
                        </div>

                        <button type="submit" class="btn btn-primary-custom w-100 mt-2">
                            <i class="fa fa-search me-2"></i> Áp dụng bộ lọc
                        </button>
                    </form>
                </div>
            </div>

            <div class="col-lg-9 col-md-8">
                <div class="shop-search-bar" id="shopSearchBar">
                    <div class="input-group">
                        <input type="text"
                               class="form-control"
                               id="shopKeywordInput"
                               name="keyword"
                               value="@Model?.Filter?.Keyword"
                               placeholder="Tìm kiếm tên sản phẩm..." />
                        <button type="button" class="btn-search" id="shopSearchBtn">
                            <i class="fa fa-search"></i>
                        </button>
                    </div>
                </div>

            <div id="shopResults">
                <!-- breadcrumb danh mục -->
                @if (Model?.SelectedCategoryBreadcrumb?.Any() == true)
                {
                    <nav aria-label="breadcrumb" class="mb-2">
                        <ol class="breadcrumb small mb-0">
                            <li class="breadcrumb-item">
                                <a asp-area="Customers" asp-controller="Shop" asp-action="Index">Tất cả</a>
                            </li>
                            @foreach (var bc in Model.SelectedCategoryBreadcrumb)
                            {
                                <li class="breadcrumb-item active">@bc.Name</li>
                            }
                        </ol>
                    </nav>
                }
                <div class="d-flex justify-content-between align-items-center mb-4 p-3 bg-white rounded shadow-sm">
                    <span class="text-muted">
                        Tìm thấy <strong>@(Model?.TotalProducts ?? 0)</strong> sản phẩm
                    </span>
                    <div>
                        <select class="form-select form-select-sm" style="width: auto;" id="sortBy">
                            <option value="newest"     selected="@(Model?.SortBy == "newest"     ? "selected" : null)">Mới nhất</option>
                            <option value="price-asc"  selected="@(Model?.SortBy == "price-asc"  ? "selected" : null)">Giá: Thấp → Cao</option>
                            <option value="price-desc" selected="@(Model?.SortBy == "price-desc" ? "selected" : null)">Giá: Cao → Thấp</option>
                            <option value="popular"    selected="@(Model?.SortBy == "popular"    ? "selected" : null)">Phổ biến nhất</option>
                        </select>
                    </div>
                </div>
                <!-- thẻ sản phẩm -->
                <div class="row" id="productGrid">
                    @if (Model?.Products != null && Model.Products.Any())
                    {
                        @foreach (var product in Model.Products)
                        {
                            <div class="col-xl-4 col-lg-4 col-md-6 col-sm-6">
                                <a class="shop-card-link"
                                   asp-area="Customers"
                                   asp-controller="Shop"
                                   asp-action="Detail"
                                   asp-route-slug="@product.Slug">
                                    <div class="glasses_box shop_item shop-card position-relative">
                                        @if (product.IsOnSale)
                                        {
                                            <span class="sale-badge">-@product.DiscountPercent%</span>
                                        }
                                        <figure>
                                            <img src="@(product.ThumbnailUrl ?? "~/images/no-image.png")" alt="@product.Name" />
                                        </figure>
                                        <h3>
                                            <span class="blu">₫</span>@product.DisplayPrice.ToString("N0")
                                            @if (product.IsOnSale)
                                            {
                                                <small class="original-price ms-2">₫@product.BasePrice.ToString("N0")</small>
                                            }
                                        </h3>
                                        <p>@product.Name</p>
                                    </div>
                                </a>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="col-12 text-center py-5">
                            <i class="fa fa-search fa-3x text-muted mb-3"></i>
                            <p class="text-muted">Không tìm thấy sản phẩm nào phù hợp.</p>
                            <button class="btn btn-outline-primary" id="clearFiltersEmpty">Xóa bộ lọc</button>
                        </div>
                    }
                </div>
                @if (Model?.TotalPages > 1)
                {
                    <nav class="mt-4 shop-pagination">
                        <ul class="pagination justify-content-center">
                            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" data-page="@(Model.CurrentPage - 1)" href="#">Trước</a>
                            </li>
                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" data-page="@i" href="#">@i</a>
                                </li>
                            }
                            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" data-page="@(Model.CurrentPage + 1)" href="#">Sau</a>
                            </li>
                        </ul>
                    </nav>
                }

            </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script src="~/js/shop.js"></script>
}
