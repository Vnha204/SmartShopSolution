@{
    ViewData["Title"] = "Giới thiệu";
    ViewData["ActivePage"] = "About";
    ViewData["BodyClass"] = "position_head";
}

<div class="about inner_page">
    <div class="container">
        <div class="row d_flex">
            <div class="col-md-5">
                <div class="about_img">
                    <figure><img src="~/images/about_img.png" alt="About SmartShop" /></figure>
                </div>
            </div>
            <div class="col-md-7">
                <div class="titlepage">
                    <h2>Về cửa hàng chúng tôi</h2>
                    <p>
                        SmartShop là thương hiệu kính mắt uy tín được thành lập với sứ mệnh mang đến
                        những sản phẩm kính chất lượng cao cho mọi khách hàng. Chúng tôi không ngừng
                        cập nhật các xu hướng thời trang mới nhất, đảm bảo bạn luôn có lựa chọn phù
                        hợp với phong cách và nhu cầu của mình.
                    </p>
                    <p>
                        Với đội ngũ nhân viên được đào tạo chuyên sâu và hệ thống phân phối trên toàn
                        quốc, SmartShop cam kết mang đến trải nghiệm mua sắm thuận tiện, nhanh chóng
                        và đáng tin cậy cho mọi khách hàng.
                    </p>
                </div>
                <a class="read_more" asp-area="Customers" asp-controller="Shop" asp-action="Index">Mua sắm ngay</a>
            </div>
        </div>
    </div>
</div>
<div class="glasses" style="padding: 60px 0;">
    <div class="container">
        <div class="row">
            <div class="col-md-10 offset-md-1">
                <div class="titlepage">
                    <h2>Tại sao chọn chúng tôi?</h2>
                    <p>Chúng tôi cam kết mang đến trải nghiệm mua kính mắt tốt nhất cho khách hàng.</p>
                </div>
            </div>
        </div>
        <div class="row" style="margin-top: 30px;">
            <div class="col-md-4 text-center" style="padding: 20px;">
                <i class="fa fa-eye fa-3x blu" style="margin-bottom: 15px;"></i>
                <h4 style="font-weight:600;">Chất lượng cao cấp</h4>
                <p>Mọi gọng kính và tròng kính đều được làm từ vật liệu cao cấp, đảm bảo độ bền và sự thoải mái lâu dài.</p>
            </div>
            <div class="col-md-4 text-center" style="padding: 20px;">
                <i class="fa fa-shield fa-3x blu" style="margin-bottom: 15px;"></i>
                <h4 style="font-weight:600;">Bảo vệ tia UV</h4>
                <p>Mỗi cặp kính mát đều được trang bị tính năng chống tia UV400, bảo vệ mắt bạn tối ưu.</p>
            </div>
            <div class="col-md-4 text-center" style="padding: 20px;">
                <i class="fa fa-truck fa-3x blu" style="margin-bottom: 15px;"></i>
                <h4 style="font-weight:600;">Giao hàng nhanh</h4>
                <p>Chúng tôi đảm bảo giao hàng nhanh chóng và an toàn đến tận tay bạn, mọi lúc mọi nơi.</p>
            </div>
        </div>
    </div>
</div>
