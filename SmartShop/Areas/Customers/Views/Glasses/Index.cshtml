@{
    ViewData["Title"] = "Bộ sưu tập kính";
    ViewData["ActivePage"] = "Glasses";
    ViewData["BodyClass"] = "position_head";
}

<!-- glasses page -->
<div class="glasses inner_page">
    <div class="container">
        <div class="row">
            <div class="col-md-10 offset-md-1">
                <div class="titlepage">
                    <h2>Bộ sưu tập kính của chúng tôi</h2>
                    <p>Khám phá đầy đủ các dòng kính mắt cao cấp — từ kính mát thời trang đến kính thuốc chính xác.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Category Filter -->
    <div class="container" style="margin-bottom: 30px;">
        <div class="row justify-content-center">
            <div class="col-md-8 text-center">
                <div class="filter-btns">
                    <button class="btn btn-filter active" data-filter="all">Tất cả</button>
                    <button class="btn btn-filter" data-filter="sunglasses">Kính mát</button>
                    <button class="btn btn-filter" data-filter="eyeglasses">Kính thuốc</button>
                    <button class="btn btn-filter" data-filter="combo">Combo</button>
                </div>
            </div>
        </div>
    </div>

    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-3 col-lg-3 col-md-6 col-sm-6" data-category="sunglasses">
                <div class="glasses_box">
                    <figure><img src="~/images/glass1.png" alt="Sunglasses" /></figure>
                    <h3><span class="blu">$</span>50</h3>
                    <p>Kính mát</p>
                    <a class="read_more" asp-area="Customers" asp-controller="Shop" asp-action="Index">Mua ngay</a>
                </div>
            </div>
            <div class="col-xl-3 col-lg-3 col-md-6 col-sm-6" data-category="sunglasses">
                <div class="glasses_box">
                    <figure><img src="~/images/glass2.png" alt="Sunglasses" /></figure>
                    <h3><span class="blu">$</span>65</h3>
                    <p>Kính mát</p>
                    <a class="read_more" asp-area="Customers" asp-controller="Shop" asp-action="Index">Mua ngay</a>
                </div>
            </div>
            <div class="col-xl-3 col-lg-3 col-md-6 col-sm-6" data-category="eyeglasses">
                <div class="glasses_box">
                    <figure><img src="~/images/glass3.png" alt="Eyeglasses" /></figure>
                    <h3><span class="blu">$</span>80</h3>
                    <p>Kính thuốc</p>
                    <a class="read_more" asp-area="Customers" asp-controller="Shop" asp-action="Index">Mua ngay</a>
                </div>
            </div>
            <div class="col-xl-3 col-lg-3 col-md-6 col-sm-6" data-category="eyeglasses">
                <div class="glasses_box">
                    <figure><img src="~/images/glass4.png" alt="Eyeglasses" /></figure>
                    <h3><span class="blu">$</span>55</h3>
                    <p>Kính thuốc</p>
                    <a class="read_more" asp-area="Customers" asp-controller="Shop" asp-action="Index">Mua ngay</a>
                </div>
            </div>
            <div class="col-xl-3 col-lg-3 col-md-6 col-sm-6" data-category="sunglasses">
                <div class="glasses_box">
                    <figure><img src="~/images/glass5.png" alt="Sunglasses" /></figure>
                    <h3><span class="blu">$</span>70</h3>
                    <p>Kính mát phân cực</p>
                    <a class="read_more" asp-area="Customers" asp-controller="Shop" asp-action="Index">Mua ngay</a>
                </div>
            </div>
            <div class="col-xl-3 col-lg-3 col-md-6 col-sm-6" data-category="sunglasses">
                <div class="glasses_box">
                    <figure><img src="~/images/glass6.png" alt="Sunglasses" /></figure>
                    <h3><span class="blu">$</span>90</h3>
                    <p>Kính mát UV400</p>
                    <a class="read_more" asp-area="Customers" asp-controller="Shop" asp-action="Index">Mua ngay</a>
                </div>
            </div>
            <div class="col-xl-3 col-lg-3 col-md-6 col-sm-6" data-category="combo">
                <div class="glasses_box">
                    <figure><img src="~/images/glass7.png" alt="Combo" /></figure>
                    <h3><span class="blu">$</span>120</h3>
                    <p>Bộ combo</p>
                    <a class="read_more" asp-area="Customers" asp-controller="Shop" asp-action="Index">Mua ngay</a>
                </div>
            </div>
            <div class="col-xl-3 col-lg-3 col-md-6 col-sm-6" data-category="combo">
                <div class="glasses_box">
                    <figure><img src="~/images/glass8.png" alt="Combo" /></figure>
                    <h3><span class="blu">$</span>140</h3>
                    <p>Bộ combo cao cấp</p>
                    <a class="read_more" asp-area="Customers" asp-controller="Shop" asp-action="Index">Mua ngay</a>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- end glasses page -->
@section Scripts {
    <script>
        document.querySelectorAll('.btn-filter').forEach(function(btn) {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.btn-filter').forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                var filter = this.getAttribute('data-filter');
                document.querySelectorAll('[data-category]').forEach(function(item) {
                    if (filter === 'all' || item.getAttribute('data-category') === filter) {
                        item.style.display = '';
                    } else {
                        item.style.display = 'none';
                    }
                });
            });
        });
    </script>
}