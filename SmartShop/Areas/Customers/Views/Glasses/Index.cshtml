@model SmartShop.Models.ViewModels.GlassesViewModel
@{
    ViewData["Title"] = "Bộ sưu tập kính";
    ViewData["ActivePage"] = "Glasses";
    ViewData["BodyClass"] = "position_head";
}
<div class="glasses inner_page">
    <div class="container">
        <div class="row">
            <div class="col-md-10 offset-md-1">
                <div class="titlepage">
                    <h2>Bộ sưu tập kính của chúng tôi</h2>
                    <p>Khám phá đầy đủ các dòng kính mắt cao cấp — từ kính mát thời trang đến kính thuốc chính xác.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- bộ lọc danh mục -->
    <div class="container glasses-filter-bar" id="glasses-filter-bar">
        <div class="row justify-content-center">
            <div class="col-md-10 text-center">
                <div class="filter-btns">
                    <a href="?filter=all"
                       data-filter="all"
                       class="btn btn-filter @(Model.ActiveFilter == "all" ? "active" : "")">Tất cả</a>
                    <a href="?filter=gong-kinh-can"
                       data-filter="gong-kinh-can"
                       class="btn btn-filter @(Model.ActiveFilter == "gong-kinh-can" ? "active" : "")">Kính cận</a>
                    <a href="?filter=kinh-ram"
                       data-filter="kinh-ram"
                       class="btn btn-filter @(Model.ActiveFilter == "kinh-ram" ? "active" : "")">Kính râm</a>
                    <a href="?filter=trong-kinh"
                       data-filter="trong-kinh"
                       class="btn btn-filter @(Model.ActiveFilter == "trong-kinh" ? "active" : "")">Tròng kính</a>
                </div>
            </div>
        </div>
    </div>

    <div class="container-fluid glasses-cards-container">
        @await Html.PartialAsync("_GlassesGrid", Model)
    </div>
</div>


@section Scripts {
    <script src="~/js/customers/glasses-filter.js" asp-append-version="true"></script>
}
