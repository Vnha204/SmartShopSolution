@{
    ViewData["Title"] = "Liên hệ";
    ViewData["ActivePage"] = "Contact";
    ViewData["BodyClass"] = "position_head";
    ViewData["ShowMap"] = true;

}
<div id="contact" class="contact inner_page">
    <div class="container-fluid" style="margin-top: 40px;">
        <div class="map_section">
            <div id="map" style="height:400px; background:#e5e5e5; display:flex; align-items:center; justify-content:center;">
                <p style="color:#999;">Bản đồ đang tải...</p>
            </div>
            <form id="request" class="main_form">
                <div class="row">
                    <div class="col-md-12">
                        <h3>Liên hệ với chúng tôi</h3>
                    </div>
                    <div class="col-md-12">
                        <input class="contactus" placeholder="Họ tên" type="text" name="Name" />
                    </div>
                    <div class="col-md-12">
                        <input class="contactus" placeholder="Số điện thoại" type="tel" name="PhoneNumber" />
                    </div>
                    <div class="col-md-12">
                        <input class="contactus" placeholder="Email" type="email" name="Email" />
                    </div>
                    <div class="col-md-12">
                        <input class="contactusmess" placeholder="Tin nhắn" type="text" name="Message" />
                    </div>
                    <div class="col-md-12">
                        <button class="send_btn" type="submit">Gửi</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
    <div class="container text-center">
        <div class="col-md-12">
            <div class="contact_info" style="padding: 30px 0;">
                <h3>Thông tin liên hệ</h3>
                <ul class="list-unstyled" style="margin-top: 20px;">
                    <li style="margin-bottom: 15px;">
                        <i class="fa fa-map-marker" class="contact-icon"></i>
                        123 Đường Kính Mắt, Quận Thời Trang
                    </li>
                    <li style="margin-bottom: 15px;">
                        <i class="fa fa-phone" class="contact-icon"></i>
                        0987654321
                    </li>
                    <li style="margin-bottom: 15px;">
                        <i class="fa fa-envelope" class="contact-icon"></i>
                        anhdoviet0@gmail.com
                    </li>
                    <li style="margin-bottom: 15px;">
                        <i class="fa fa-clock-o" class="contact-icon"></i>
                        Thứ 2 - Thứ 7: 9:00 SA - 6:00 CH
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script src="~/js/contact.js" asp-append-version="true"></script>
}