@{
    ViewData["Title"] = "Contact Us";
    ViewData["ActivePage"] = "Contact";
    ViewData["BodyClass"] = "position_head";
    ViewData["ShowMap"] = true;

}

<!-- contact section -->
<div id="contact" class="contact inner_page">
    <div class="container-fluid" style="margin-top: 40px;">
        <div class="map_section">
            <div id="map" style="height:400px; background:#e5e5e5; display:flex; align-items:center; justify-content:center;">
                <p style="color:#999;">Map loading...</p>
            </div>
            <form id="request" class="main_form">
                <div class="row">
                    <div class="col-md-12">
                        <h3>Contact Us</h3>
                    </div>
                    <div class="col-md-12">
                        <input class="contactus" placeholder="Name" type="text" name="Name" />
                    </div>
                    <div class="col-md-12">
                        <input class="contactus" placeholder="Phone Number" type="tel" name="PhoneNumber" />
                    </div>
                    <div class="col-md-12">
                        <input class="contactus" placeholder="Email" type="email" name="Email" />
                    </div>
                    <div class="col-md-12">
                        <input class="contactusmess" placeholder="Message" type="text" name="Message" />
                    </div>
                    <div class="col-md-12">
                        <button class="send_btn" type="submit">Send</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
    <div class="container text-center">
        <div class="col-md-12">
            <div class="contact_info" style="padding: 30px 0;">
                <h3>Get In Touch</h3>
                <ul class="list-unstyled" style="margin-top: 20px;">
                    <li style="margin-bottom: 15px;">
                        <i class="fa fa-map-marker" style="color:#3498db; margin-right:10px;"></i>
                        123 Eyewear Street, Fashion District
                    </li>
                    <li style="margin-bottom: 15px;">
                        <i class="fa fa-phone" style="color:#3498db; margin-right:10px;"></i>
                        +01 1234567890
                    </li>
                    <li style="margin-bottom: 15px;">
                        <i class="fa fa-envelope" style="color:#3498db; margin-right:10px;"></i>
                        contact@smartshop.com
                    </li>
                    <li style="margin-bottom: 15px;">
                        <i class="fa fa-clock-o" style="color:#3498db; margin-right:10px;"></i>
                        Mon - Sat: 9:00 AM - 6:00 PM
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
<!-- end contact section -->