@model IEnumerable<SmartShop.Models.Order>
@{
    ViewData["Title"] = "Đơn hàng của tôi";
    ViewData["ActivePage"] = "Orders";
    ViewData["BodyClass"] = "position_head";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="orders-section">
    <div class="container">
        <h1 class="orders-title">Đơn hàng của tôi</h1>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (!Model.Any())
        {
            <div class="orders-card">
                <div class="orders-empty">
                    <i class="fa fa-shopping-bag"></i>
                    <p>Bạn chưa có đơn hàng nào.</p>
                    <a asp-area="Customers" asp-controller="Shop" asp-action="Index"
                       class="btn btn-primary btn-sm">
                        Tiếp tục mua sắm
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="orders-card">
                <table class="table orders-table mb-0">
                    <thead>
                        <tr>
                            <th>Mã đơn hàng</th>
                            <th>Ngày đặt</th>
                            <th>Sản phẩm</th>
                            <th>Tổng tiền</th>
                            <th>Thanh toán</th>
                            <th>Trạng thái</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td><span class="order-code">#@order.OrderCode</span></td>
                                <td>
                                    <div>@order.CreatedAt.ToString("dd/MM/yyyy")</div>
                                    <small class="text-muted">@order.CreatedAt.ToString("HH:mm")</small>
                                </td>
                                <td>@order.OrderItems.Count sản phẩm</td>
                                <td class="fw-semibold">@order.TotalPrice.ToString("N0")₫</td>
                                <td>
                                    @{
                                        var payBadge = order.PaymentStatus switch {
                                            "paid"    => ("order-badge-paid",       "Đã thanh toán"),
                                            "pending" => ("order-badge-pending-pay","Chờ thanh toán"),
                                            _         => ("order-badge-unpaid",     "Chưa thanh toán")
                                        };
                                    }
                                    <span class="order-badge @payBadge.Item1">@payBadge.Item2</span>
                                </td>
                                <td>
                                    @{
                                        var statusBadge = order.Status switch {
                                            "pending"    => ("order-badge-pending",   "Chờ xác nhận"),
                                            "confirmed"  => ("order-badge-confirmed", "Đã xác nhận"),
                                            "processing" => ("order-badge-processing","Đang xử lý"),
                                            "shipping"   => ("order-badge-shipping",  "Đang giao"),
                                            "delivered"  => ("order-badge-delivered", "Đã giao"),
                                            "cancelled"  => ("order-badge-cancelled", "Đã huỷ"),
                                            _            => ("order-badge-pending",   order.Status)
                                        };
                                    }
                                    <span class="order-badge @statusBadge.Item1">@statusBadge.Item2</span>
                                </td>
                                <td>
                                    <a asp-area="Customers" asp-controller="Orders"
                                       asp-action="Details" asp-route-orderId="@order.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="fa fa-eye"></i> Chi tiết
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
